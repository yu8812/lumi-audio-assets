			"speaker": "說書人",
			"text": "第三十九卦,蹇。",
			"startMs": 0,
			"endMs": 2180
		},
		{
			"speaker": "說書人",
			"text": "蹇利西南,不利東北;利見大人,貞吉。",
			"startMs": 2180,
			"endMs": 7980
		},
		{
			"speaker": "說書人",
			"text": "初六往蹇,來譽。",
			"startMs": 7980,
			"endMs": 11360
		},
		{
			"speaker": "說書人",
			"text": "六二王臣蹇蹇,匪躬之故。",
			"startMs": 11360,
			"endMs": 15680
		},
		{
			"speaker": "說書人",
			"text": "九三往蹇,來反。",
			"startMs": 15680,
			"endMs": 17980
		},
		{
			"speaker": "說書人",
			"text": "六四往蹇,來連。",
			"startMs": 17980,
			"endMs": 21440
		},
		{
			"speaker": "說書人",
			"text": "九五大蹇,朋來。",
			"startMs": 21440,
			"endMs": 24340
		},
		{
			"speaker": "說書人",
			"text": "上六往蹇,來碩,吉,利見大人。",
			"startMs": 24340,
			"endMs": 29700
		}
	]
