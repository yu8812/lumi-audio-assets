			"speaker": "說書人",
			"text": "第三十九卦,蹇。",
			"startMs": 0,
			"endMs": 2180
		},
		{
			"speaker": "說書人",
			"text": "蹇利西南,不利東北;利見大人,貞吉。",
			"startMs": 2180,
			"endMs": 7060
		},
		{
			"speaker": "說書人",
			"text": "初六往蹇,來譽。",
			"startMs": 7060,
			"endMs": 9800
		},
		{
			"speaker": "說書人",
			"text": "六二王臣蹇蹇,匪躬之故。",
			"startMs": 9800,
			"endMs": 13760
		},
		{
			"speaker": "說書人",
			"text": "九三往蹇,來反。",
			"startMs": 13760,
			"endMs": 16380
		},
		{
			"speaker": "說書人",
			"text": "六四往蹇,來連。",
			"startMs": 16380,
			"endMs": 19120
		},
		{
			"speaker": "說書人",
			"text": "九五大蹇,朋來。",
			"startMs": 19120,
			"endMs": 21740
		},
		{
			"speaker": "說書人",
			"text": "上六往蹇,來碩,吉,利見大人。",
			"startMs": 21740,
			"endMs": 26020
		}
	]
