			"speaker": "說書人",
			"text": "第三十九卦,蹇。",
			"startMs": 0,
			"endMs": 1700
		},
		{
			"speaker": "說書人",
			"text": "蹇利西南,不利東北;利見大人,貞吉。",
			"startMs": 1700,
			"endMs": 6740
		},
		{
			"speaker": "說書人",
			"text": "初六往蹇,來譽。",
			"startMs": 6740,
			"endMs": 9360
		},
		{
			"speaker": "說書人",
			"text": "六二王臣蹇蹇,匪躬之故。",
			"startMs": 9360,
			"endMs": 13200
		},
		{
			"speaker": "說書人",
			"text": "九三往蹇,來反。",
			"startMs": 13200,
			"endMs": 15860
		},
		{
			"speaker": "說書人",
			"text": "六四往蹇,來連。",
			"startMs": 15860,
			"endMs": 18600
		},
		{
			"speaker": "說書人",
			"text": "九五大蹇,朋來。",
			"startMs": 18600,
			"endMs": 21220
		},
		{
			"speaker": "說書人",
			"text": "上六往蹇,來碩,吉,利見大人。",
