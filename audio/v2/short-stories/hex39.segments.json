		{
			"speaker": "說書人",
			"text": "第三十九卦,蹇。",
			"startMs": 0,
			"endMs": 2260
		},
		{
			"speaker": "說書人",
			"text": "蹇利西南,不利東北;利見大人,貞吉。",
			"startMs": 2260,
			"endMs": 7940
		},
		{
			"speaker": "說書人",
			"text": "初六往蹇,來譽。",
			"startMs": 7940,
			"endMs": 10800
		},
		{
			"speaker": "說書人",
			"text": "六二王臣蹇蹇,匪躬之故。",
			"startMs": 10800,
			"endMs": 14760
		},
		{
			"speaker": "說書人",
			"text": "九三往蹇,來反。",
			"startMs": 14760,
			"endMs": 17780
		},
		{
			"speaker": "說書人",
			"text": "六四往蹇,來連。",
			"startMs": 17780,
			"endMs": 20400
		},
		{
			"speaker": "說書人",
			"text": "九五大蹇,朋來。",
			"startMs": 20400,
			"endMs": 23620
		},
		{
			"speaker": "說書人",
			"text": "上六往蹇,來碩,吉,利見大人。",
			"startMs": 23620,
			"endMs": 28820
		}
	]
