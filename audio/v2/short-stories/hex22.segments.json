	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十二卦,賁。",
			"startMs": 0,
			"endMs": 1980
		},
		{
			"speaker": "讀者",
			"text": "賁亨。小利有攸往。",
			"startMs": 1980,
			"endMs": 5200
		},
		{
			"speaker": "讀者",
			"text": "初九賁其趾,舍車而徒。",
			"startMs": 5200,
			"endMs": 9020
		},
		{
			"speaker": "讀者",
			"text": "六二賁其須。",
			"startMs": 9020,
			"endMs": 11480
		},
		{
			"speaker": "讀者",
			"text": "九三賁如濡如,永貞吉。",
			"startMs": 11480,
			"endMs": 15340
		},
		{
			"speaker": "讀者",
			"text": "六四賁如皤如,白馬翰如。匪寇婚媾。",
			"startMs": 15340,
			"endMs": 20920
		},
		{
			"speaker": "讀者",
			"text": "六五賁于丘園,束帛戔戔。吝,終吉。",
			"startMs": 20920,
			"endMs": 26900
		},
		{
			"speaker": "讀者",
			"text": "上九白賁,无咎。",
			"startMs": 26900,
			"endMs": 29840
		}
	]
}
