	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十二卦,賁。",
			"startMs": 0,
			"endMs": 1940
		},
		{
			"speaker": "說書人",
			"text": "賁亨。小利有攸往。",
			"startMs": 1940,
			"endMs": 6040
		},
		{
			"speaker": "說書人",
			"text": "初九賁其趾,舍車而徒。",
			"startMs": 6040,
			"endMs": 10060
		},
		{
			"speaker": "說書人",
			"text": "六二賁其須。",
			"startMs": 10060,
			"endMs": 12280
		},
		{
			"speaker": "說書人",
			"text": "九三賁如濡如,永貞吉。",
			"startMs": 12280,
			"endMs": 16140
		},
		{
			"speaker": "說書人",
			"text": "六四賁如皤如,白馬翰如。匪寇婚媾。",
			"startMs": 16140,
			"endMs": 21800
		},
		{
			"speaker": "說書人",
			"text": "六五賁于丘園,束帛戔戔。吝,終吉。",
			"startMs": 21800,
			"endMs": 27660
		},
		{
			"speaker": "說書人",
			"text": "上九白賁,无咎。",
			"startMs": 27660,
			"endMs": 30760
		}
	]
}
