	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十二卦,賁。",
			"startMs": 0,
			"endMs": 1940
		},
		{
			"speaker": "說書人",
			"text": "賁亨。小利有攸往。",
			"startMs": 1940,
			"endMs": 5560
		},
		{
			"speaker": "說書人",
			"text": "初九賁其趾,舍車而徒。",
			"startMs": 5560,
			"endMs": 9580
		},
		{
			"speaker": "說書人",
			"text": "六二賁其須。",
			"startMs": 9580,
			"endMs": 11960
		},
		{
			"speaker": "說書人",
			"text": "九三賁如濡如,永貞吉。",
			"startMs": 11960,
			"endMs": 16620
		},
		{
			"speaker": "說書人",
			"text": "六四賁如皤如,白馬翰如。匪寇婚媾。",
			"startMs": 16620,
			"endMs": 22760
		},
		{
			"speaker": "說書人",
			"text": "六五賁于丘園,束帛戔戔。吝,終吉。",
			"startMs": 22760,
			"endMs": 28140
		},
		{
			"speaker": "說書人",
			"text": "上九白賁,无咎。",
			"startMs": 28140,
			"endMs": 31160
		}
	]
}
