{
	"slug": "hex30",
	"title": "第三十卦 離",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex30.mp3",
	"durationMs": 31700,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第三十卦,離。",
			"startMs": 0,
			"endMs": 1660
		},
		{
			"speaker": "說書人",
			"text": "離利貞,亨。畜牝牛吉。",
			"startMs": 1660,
			"endMs": 5380
		},
		{
			"speaker": "說書人",
			"text": "初九履錯然,敬之,无咎。",
			"startMs": 5380,
			"endMs": 8560
		},
		{
			"speaker": "說書人",
			"text": "六二黃離,元吉。",
			"startMs": 8560,
			"endMs": 11460
		},
		{
			"speaker": "說書人",
			"text": "九三日昃之離,不鼓缶而歌,則大耋之嗟,凶。",
			"startMs": 11460,
			"endMs": 17360
		},
		{
			"speaker": "說書人",
			"text": "九四突如其來如,焚如,死如,棄如。",
			"startMs": 17360,
			"endMs": 22400
		},
		{
			"speaker": "說書人",
			"text": "六五出涕沱若,戚嗟若,吉。",
			"startMs": 22400,
			"endMs": 26320
		},
		{
			"speaker": "說書人",
			"text": "上九王用出征,有嘉折首,獲匪其醜,无咎。",
			"startMs": 26320,
			"endMs": 31700
		}
	]
}
