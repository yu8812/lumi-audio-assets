	"segments": [
		{
			"speaker": "說書人",
			"text": "第三十卦,離。",
			"startMs": 0,
			"endMs": 1900
		},
		{
			"speaker": "說書人",
			"text": "離利貞,亨。畜牝牛吉。",
			"startMs": 1900,
			"endMs": 5620
		},
		{
			"speaker": "說書人",
			"text": "初九履錯然,敬之,无咎。",
			"startMs": 5620,
			"endMs": 9760
		},
		{
			"speaker": "說書人",
			"text": "六二黃離,元吉。",
			"startMs": 9760,
			"endMs": 12860
		},
		{
			"speaker": "說書人",
			"text": "九三日昃之離,不鼓缶而歌,則大耋之嗟,凶。",
			"startMs": 12860,
			"endMs": 18720
		},
		{
			"speaker": "說書人",
			"text": "九四突如其來如,焚如,死如,棄如。",
			"startMs": 18720,
			"endMs": 24360
		},
		{
			"speaker": "說書人",
			"text": "六五出涕沱若,戚嗟若,吉。",
			"startMs": 24360,
			"endMs": 28480
		},
		{
			"speaker": "說書人",
			"text": "上九王用出征,有嘉折首,獲匪其醜,无咎。",
			"startMs": 28480,
			"endMs": 34740
		}
	]
}
