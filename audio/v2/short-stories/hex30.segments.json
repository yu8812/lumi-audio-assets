	"segments": [
		{
			"speaker": "說書人",
			"text": "第三十卦,離。",
			"startMs": 0,
			"endMs": 1700
		},
		{
			"speaker": "說書人",
			"text": "離利貞,亨。畜牝牛吉。",
			"startMs": 1700,
			"endMs": 6420
		},
		{
			"speaker": "說書人",
			"text": "初九履錯然,敬之,无咎。",
			"startMs": 6420,
			"endMs": 10440
		},
		{
			"speaker": "說書人",
			"text": "六二黃離,元吉。",
			"startMs": 10440,
			"endMs": 13580
		},
		{
			"speaker": "說書人",
			"text": "九三日昃之離,不鼓缶而歌,則大耋之嗟,凶。",
			"startMs": 13580,
			"endMs": 20120
		},
		{
			"speaker": "說書人",
			"text": "九四突如其來如,焚如,死如,棄如。",
			"startMs": 20120,
			"endMs": 25480
		},
		{
			"speaker": "說書人",
			"text": "六五出涕沱若,戚嗟若,吉。",
			"startMs": 25480,
			"endMs": 30080
		},
		{
			"speaker": "說書人",
			"text": "上九王用出征,有嘉折首,獲匪其醜,无咎。",
			"startMs": 30080,
			"endMs": 36460
		}
	]
}
