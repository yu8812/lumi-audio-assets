	"segments": [
		{
			"speaker": "說書人",
			"text": "第十八卦,蠱。",
			"startMs": 0,
			"endMs": 1940
		},
		{
			"speaker": "讀者",
			"text": "蠱元亨,利涉大川。先甲三日,後甲三日。",
			"startMs": 1940,
			"endMs": 8480
		},
		{
			"speaker": "讀者",
			"text": "初六幹父之蠱,有子,考无咎,厲終吉。",
			"startMs": 8480,
			"endMs": 14120
		},
		{
			"speaker": "讀者",
			"text": "九二幹母之蠱,不可貞。",
			"startMs": 14120,
			"endMs": 17700
		},
		{
			"speaker": "讀者",
			"text": "九三幹父之蠱,小有悔,无大咎。",
			"startMs": 17700,
			"endMs": 22580
		},
		{
			"speaker": "讀者",
			"text": "六四裕父之蠱,往見吝。",
			"startMs": 22580,
			"endMs": 26280
		},
		{
			"speaker": "讀者",
			"text": "六五幹父之蠱,用譽。",
			"startMs": 26280,
			"endMs": 29820
		},
		{
			"speaker": "讀者",
			"text": "上九不事王侯,高尚其事。",
			"startMs": 29820,
			"endMs": 34100
		}
	]
}
