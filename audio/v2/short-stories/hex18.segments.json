	"segments": [
		{
			"speaker": "說書人",
			"text": "第十八卦,蠱。",
			"startMs": 0,
			"endMs": 1500
		},
		{
			"speaker": "說書人",
			"text": "蠱元亨,利涉大川。先甲三日,後甲三日。",
			"startMs": 1500,
			"endMs": 7360
		},
		{
			"speaker": "說書人",
			"text": "初六幹父之蠱,有子,考无咎,厲終吉。",
			"startMs": 7360,
			"endMs": 12240
		},
		{
			"speaker": "說書人",
			"text": "九二幹母之蠱,不可貞。",
			"startMs": 12240,
			"endMs": 15220
		},
		{
			"speaker": "說書人",
			"text": "九三幹父之蠱,小有悔,无大咎。",
			"startMs": 15220,
			"endMs": 19780
		},
		{
			"speaker": "說書人",
			"text": "六四裕父之蠱,往見吝。",
			"startMs": 19780,
			"endMs": 22880
		},
		{
			"speaker": "說書人",
			"text": "六五幹父之蠱,用譽。",
			"startMs": 22880,
			"endMs": 25860
		},
		{
			"speaker": "說書人",
			"text": "上九不事王侯,高尚其事。",
			"startMs": 25860,
			"endMs": 29700
		}
	]
}
