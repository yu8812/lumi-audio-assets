	"segments": [
		{
			"speaker": "說書人",
			"text": "第十八卦,蠱。",
			"startMs": 0,
			"endMs": 2260
		},
		{
			"speaker": "說書人",
			"text": "蠱元亨,利涉大川。先甲三日,後甲三日。",
			"startMs": 2260,
			"endMs": 8680
		},
		{
			"speaker": "說書人",
			"text": "初六幹父之蠱,有子,考无咎,厲終吉。",
			"startMs": 8680,
			"endMs": 14560
		},
		{
			"speaker": "說書人",
			"text": "九二幹母之蠱,不可貞。",
			"startMs": 14560,
			"endMs": 18100
		},
		{
			"speaker": "說書人",
			"text": "九三幹父之蠱,小有悔,无大咎。",
			"startMs": 18100,
			"endMs": 23020
		},
		{
			"speaker": "說書人",
			"text": "六四裕父之蠱,往見吝。",
			"startMs": 23020,
			"endMs": 26920
		},
		{
			"speaker": "說書人",
			"text": "六五幹父之蠱,用譽。",
			"startMs": 26920,
			"endMs": 30380
		},
		{
			"speaker": "說書人",
			"text": "上九不事王侯,高尚其事。",
			"startMs": 30380,
			"endMs": 34300
		}
	]
}
