{
	"slug": "hex61",
	"title": "第六十一卦 中孚",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex61.mp3",
	"durationMs": 29120,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第六十一卦,中孚。",
			"startMs": 0,
			"endMs": 1940
		},
		{
			"speaker": "說書人",
			"text": "中孚豚魚吉,利涉大川,利貞。",
			"startMs": 1940,
			"endMs": 5600
		},
		{
			"speaker": "說書人",
			"text": "初九虞吉,有它不燕。",
			"startMs": 5600,
			"endMs": 8420
		},
		{
			"speaker": "說書人",
			"text": "九二鳴鶴在陰,其子和之。我有好爵,吾與爾靡之。",
			"startMs": 8420,
			"endMs": 14860
		},
		{
			"speaker": "說書人",
			"text": "六三得敵,或鼓或罷,或泣或歌。",
			"startMs": 14860,
			"endMs": 19140
		},
		{
			"speaker": "說書人",
			"text": "六四月幾望,馬匹亡,无咎。",
			"startMs": 19140,
			"endMs": 22560
		},
		{
			"speaker": "說書人",
			"text": "九五有孚攣如,无咎。",
			"startMs": 22560,
			"endMs": 25460
		},
		{
			"speaker": "說書人",
			"text": "上九翰音登于天,貞凶。",
			"startMs": 25460,
			"endMs": 29120
		}
	]
}
