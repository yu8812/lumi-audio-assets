	"slug": "hex61",
	"title": "第六十一卦 中孚",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex61.mp3",
	"durationMs": 34520,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第六十一卦,中孚。",
			"startMs": 0,
			"endMs": 2380
		},
		{
			"speaker": "讀者",
			"text": "中孚豚魚吉,利涉大川,利貞。",
			"startMs": 2380,
			"endMs": 7040
		},
		{
			"speaker": "讀者",
			"text": "初九虞吉,有它不燕。",
			"startMs": 7040,
			"endMs": 10380
		},
		{
			"speaker": "讀者",
			"text": "九二鳴鶴在陰,其子和之。我有好爵,吾與爾靡之。",
			"startMs": 10380,
			"endMs": 17860
		},
		{
			"speaker": "讀者",
			"text": "六三得敵,或鼓或罷,或泣或歌。",
			"startMs": 17860,
			"endMs": 23300
		},
		{
			"speaker": "讀者",
			"text": "六四月幾望,馬匹亡,无咎。",
			"startMs": 23300,
			"endMs": 27480
		},
		{
			"speaker": "讀者",
			"text": "九五有孚攣如,无咎。",
			"startMs": 27480,
			"endMs": 30860
		},
		{
			"speaker": "讀者",
			"text": "上九翰音登于天,貞凶。",
			"startMs": 30860,
			"endMs": 34520
		}
	]
}
