	"segments": [
		{
			"speaker": "說書人",
			"text": "第七卦,師。",
			"startMs": 0,
			"endMs": 1380
		},
		{
			"speaker": "說書人",
			"text": "師貞,丈人吉,无咎。",
			"startMs": 1380,
			"endMs": 5160
		},
		{
			"speaker": "說書人",
			"text": "初六師出以律,否臧凶。",
			"startMs": 5160,
			"endMs": 8860
		},
		{
			"speaker": "說書人",
			"text": "九二在師中,吉,无咎,王三錫命。",
			"startMs": 8860,
			"endMs": 13740
		},
		{
			"speaker": "說書人",
			"text": "六三師或輿尸,凶。",
			"startMs": 13740,
			"endMs": 16680
		},
		{
			"speaker": "說書人",
			"text": "六四師左次,无咎。",
			"startMs": 16680,
			"endMs": 19900
		},
		{
			"speaker": "說書人",
			"text": "六五田有禽,利執言,无咎。長子帥師,弟子輿尸,貞凶。",
			"startMs": 19900,
			"endMs": 28720
		},
		{
			"speaker": "說書人",
			"text": "上六大君有命,開國承家,小人勿用。",
			"startMs": 28720,
			"endMs": 34060
		}
	]
}
