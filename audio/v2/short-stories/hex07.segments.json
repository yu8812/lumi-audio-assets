	"segments": [
		{
			"speaker": "說書人",
			"text": "第七卦,師。",
			"startMs": 0,
			"endMs": 1380
		},
		{
			"speaker": "說書人",
			"text": "師貞,丈人吉,无咎。",
			"startMs": 1380,
			"endMs": 4120
		},
		{
			"speaker": "說書人",
			"text": "初六師出以律,否臧凶。",
			"startMs": 4120,
			"endMs": 7340
		},
		{
			"speaker": "說書人",
			"text": "九二在師中,吉,无咎,王三錫命。",
			"startMs": 7340,
			"endMs": 11580
		},
		{
			"speaker": "說書人",
			"text": "六三師或輿尸,凶。",
			"startMs": 11580,
			"endMs": 14520
		},
		{
			"speaker": "說書人",
			"text": "六四師左次,无咎。",
			"startMs": 14520,
			"endMs": 17300
		},
		{
			"speaker": "說書人",
			"text": "六五田有禽,利執言,无咎。長子帥師,弟子輿尸,貞凶。",
			"startMs": 17300,
			"endMs": 23880
		},
		{
			"speaker": "說書人",
			"text": "上六大君有命,開國承家,小人勿用。",
			"startMs": 23880,
			"endMs": 29140
		}
	]
}
