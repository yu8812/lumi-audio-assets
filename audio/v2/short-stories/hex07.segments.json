	"segments": [
		{
			"speaker": "說書人",
			"text": "第七卦,師。",
			"startMs": 0,
			"endMs": 1860
		},
		{
			"speaker": "說書人",
			"text": "師貞,丈人吉,无咎。",
			"startMs": 1860,
			"endMs": 5200
		},
		{
			"speaker": "說書人",
			"text": "初六師出以律,否臧凶。",
			"startMs": 5200,
			"endMs": 8500
		},
		{
			"speaker": "說書人",
			"text": "九二在師中,吉,无咎,王三錫命。",
			"startMs": 8500,
			"endMs": 13340
		},
		{
			"speaker": "說書人",
			"text": "六三師或輿尸,凶。",
			"startMs": 13340,
			"endMs": 16400
		},
		{
			"speaker": "說書人",
			"text": "六四師左次,无咎。",
			"startMs": 16400,
			"endMs": 19300
		},
		{
			"speaker": "說書人",
			"text": "六五田有禽,利執言,无咎。長子帥師,弟子輿尸,貞凶。",
			"startMs": 19300,
			"endMs": 26840
		},
		{
			"speaker": "說書人",
			"text": "上六大君有命,開國承家,小人勿用。",
			"startMs": 26840,
			"endMs": 32100
		}
	]
}
