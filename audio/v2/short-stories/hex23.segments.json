		{
			"speaker": "說書人",
			"text": "第二十三卦,剝。",
			"startMs": 0,
			"endMs": 1500
		},
		{
			"speaker": "說書人",
			"text": "剝不利有攸往。",
			"startMs": 1500,
			"endMs": 3880
		},
		{
			"speaker": "說書人",
			"text": "初六剝床以足,蔑貞凶。",
			"startMs": 3880,
			"endMs": 6980
		},
		{
			"speaker": "說書人",
			"text": "六二剝床以辨,蔑貞凶。",
			"startMs": 6980,
			"endMs": 10160
		},
		{
			"speaker": "說書人",
			"text": "六三剝之,无咎。",
			"startMs": 10160,
			"endMs": 12660
		},
		{
			"speaker": "說書人",
			"text": "六四剝床以膚,凶。",
			"startMs": 12660,
			"endMs": 15520
		},
		{
			"speaker": "說書人",
			"text": "六五貫魚,以宮人寵,无不利。",
			"startMs": 15520,
			"endMs": 18980
		},
		{
			"speaker": "說書人",
			"text": "上九碩果不食,君子得輿,小人剝廬。",
			"startMs": 18980,
			"endMs": 24360
		}
	]
}
