	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十三卦,剝。",
			"startMs": 0,
			"endMs": 1820
		},
		{
			"speaker": "讀者",
			"text": "剝不利有攸往。",
			"startMs": 1820,
			"endMs": 4280
		},
		{
			"speaker": "讀者",
			"text": "初六剝床以足,蔑貞凶。",
			"startMs": 4280,
			"endMs": 7940
		},
		{
			"speaker": "讀者",
			"text": "六二剝床以辨,蔑貞凶。",
			"startMs": 7940,
			"endMs": 11600
		},
		{
			"speaker": "讀者",
			"text": "六三剝之,无咎。",
			"startMs": 11600,
			"endMs": 14300
		},
		{
			"speaker": "讀者",
			"text": "六四剝床以膚,凶。",
			"startMs": 14300,
			"endMs": 17360
		},
		{
			"speaker": "讀者",
			"text": "六五貫魚,以宮人寵,无不利。",
			"startMs": 17360,
			"endMs": 21420
		},
		{
			"speaker": "讀者",
			"text": "上九碩果不食,君子得輿,小人剝廬。",
			"startMs": 21420,
			"endMs": 27280
		}
	]
}
