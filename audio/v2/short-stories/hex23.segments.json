		{
			"speaker": "說書人",
			"text": "第二十三卦,剝。",
			"startMs": 0,
			"endMs": 2500
		},
		{
			"speaker": "說書人",
			"text": "剝不利有攸往。",
			"startMs": 2500,
			"endMs": 5040
		},
		{
			"speaker": "說書人",
			"text": "初六剝床以足,蔑貞凶。",
			"startMs": 5040,
			"endMs": 8860
		},
		{
			"speaker": "說書人",
			"text": "六二剝床以辨,蔑貞凶。",
			"startMs": 8860,
			"endMs": 13080
		},
		{
			"speaker": "說書人",
			"text": "六三剝之,无咎。",
			"startMs": 13080,
			"endMs": 16140
		},
		{
			"speaker": "說書人",
			"text": "六四剝床以膚,凶。",
			"startMs": 16140,
			"endMs": 19280
		},
		{
			"speaker": "說書人",
			"text": "六五貫魚,以宮人寵,无不利。",
			"startMs": 19280,
			"endMs": 23620
		},
		{
			"speaker": "說書人",
			"text": "上九碩果不食,君子得輿,小人剝廬。",
			"startMs": 23620,
			"endMs": 29560
		}
	]
}
