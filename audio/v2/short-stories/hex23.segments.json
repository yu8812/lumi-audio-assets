		{
			"speaker": "說書人",
			"text": "第二十三卦,剝。",
			"startMs": 0,
			"endMs": 2020
		},
		{
			"speaker": "說書人",
			"text": "剝不利有攸往。",
			"startMs": 2020,
			"endMs": 4600
		},
		{
			"speaker": "說書人",
			"text": "初六剝床以足,蔑貞凶。",
			"startMs": 4600,
			"endMs": 8180
		},
		{
			"speaker": "說書人",
			"text": "六二剝床以辨,蔑貞凶。",
			"startMs": 8180,
			"endMs": 11400
		},
		{
			"speaker": "說書人",
			"text": "六三剝之,无咎。",
			"startMs": 11400,
			"endMs": 14380
		},
		{
			"speaker": "說書人",
			"text": "六四剝床以膚,凶。",
			"startMs": 14380,
			"endMs": 17120
		},
		{
			"speaker": "說書人",
			"text": "六五貫魚,以宮人寵,无不利。",
			"startMs": 17120,
			"endMs": 21900
		},
		{
			"speaker": "說書人",
			"text": "上九碩果不食,君子得輿,小人剝廬。",
			"startMs": 21900,
			"endMs": 27520
		}
	]
}
