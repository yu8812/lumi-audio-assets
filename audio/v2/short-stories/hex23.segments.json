		{
			"speaker": "說書人",
			"text": "第二十三卦,剝。",
			"startMs": 0,
			"endMs": 1660
		},
		{
			"speaker": "說書人",
			"text": "剝不利有攸往。",
			"startMs": 1660,
			"endMs": 4080
		},
		{
			"speaker": "說書人",
			"text": "初六剝床以足,蔑貞凶。",
			"startMs": 4080,
			"endMs": 7380
		},
		{
			"speaker": "說書人",
			"text": "六二剝床以辨,蔑貞凶。",
			"startMs": 7380,
			"endMs": 10440
		},
		{
			"speaker": "說書人",
			"text": "六三剝之,无咎。",
			"startMs": 10440,
			"endMs": 13020
		},
		{
			"speaker": "說書人",
			"text": "六四剝床以膚,凶。",
			"startMs": 13020,
			"endMs": 15840
		},
		{
			"speaker": "說書人",
			"text": "六五貫魚,以宮人寵,无不利。",
			"startMs": 15840,
			"endMs": 19140
		},
		{
			"speaker": "說書人",
			"text": "上九碩果不食,君子得輿,小人剝廬。",
			"startMs": 19140,
			"endMs": 24360
		}
	]
}
