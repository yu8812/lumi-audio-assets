	"title": "第四十四卦 姤",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex44.mp3",
	"durationMs": 30960,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第四十四卦,姤。",
			"startMs": 0,
			"endMs": 1740
		},
		{
			"speaker": "說書人",
			"text": "姤女壯,勿用取女。",
			"startMs": 1740,
			"endMs": 4440
		},
		{
			"speaker": "說書人",
			"text": "初六繫于金柅,貞吉。有攸往,見凶,羸豕孚蹢躅。",
			"startMs": 4440,
			"endMs": 11180
		},
		{
			"speaker": "說書人",
			"text": "九二包有魚,无咎,不利賓。",
			"startMs": 11180,
			"endMs": 15040
		},
		{
			"speaker": "說書人",
			"text": "九三臀无膚,其行次且,厲,无大咎。",
			"startMs": 15040,
			"endMs": 20000
		},
		{
			"speaker": "說書人",
			"text": "九四包无魚,起凶。",
			"startMs": 20000,
			"endMs": 23180
		},
		{
			"speaker": "說書人",
			"text": "九五以杞包瓜,含章,有隕自天。",
			"startMs": 23180,
			"endMs": 27460
		},
		{
			"speaker": "說書人",
			"text": "上九姤其角,吝,无咎。",
			"startMs": 27460,
			"endMs": 30960
		}
	]
}
