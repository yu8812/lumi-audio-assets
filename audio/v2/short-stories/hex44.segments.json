	"slug": "hex44",
	"title": "第四十四卦 姤",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex44.mp3",
	"durationMs": 34560,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第四十四卦,姤。",
			"startMs": 0,
			"endMs": 1940
		},
		{
			"speaker": "說書人",
			"text": "姤女壯,勿用取女。",
			"startMs": 1940,
			"endMs": 5320
		},
		{
			"speaker": "說書人",
			"text": "初六繫于金柅,貞吉。有攸往,見凶,羸豕孚蹢躅。",
			"startMs": 5320,
			"endMs": 12420
		},
		{
			"speaker": "說書人",
			"text": "九二包有魚,无咎,不利賓。",
			"startMs": 12420,
			"endMs": 16680
		},
		{
			"speaker": "說書人",
			"text": "九三臀无膚,其行次且,厲,无大咎。",
			"startMs": 16680,
			"endMs": 22320
		},
		{
			"speaker": "說書人",
			"text": "九四包无魚,起凶。",
			"startMs": 22320,
			"endMs": 25580
		},
		{
			"speaker": "說書人",
			"text": "九五以杞包瓜,含章,有隕自天。",
			"startMs": 25580,
			"endMs": 30580
		},
		{
			"speaker": "說書人",
			"text": "上九姤其角,吝,无咎。",
			"startMs": 30580,
			"endMs": 34560
		}
	]
}
