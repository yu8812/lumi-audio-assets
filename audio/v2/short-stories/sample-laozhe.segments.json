	"segments": [
		{
			"speaker": "說書人",
			"text": "第一卦,乾。",
			"startMs": 0,
			"endMs": 1340
		},
		{
			"speaker": "讀者",
			"text": "乾元、亨、利、貞。",
			"startMs": 1340,
			"endMs": 4240
		},
		{
			"speaker": "讀者",
			"text": "初九潛龍勿用。",
			"startMs": 4240,
			"endMs": 6940
		},
		{
			"speaker": "讀者",
			"text": "九二見龍在田,利見大人。",
			"startMs": 6940,
			"endMs": 10900
		},
		{
			"speaker": "讀者",
			"text": "九三君子終日乾乾,夕惕若厲,无咎。",
			"startMs": 10900,
			"endMs": 16740
		},
		{
			"speaker": "讀者",
			"text": "九四或躍在淵,无咎。",
			"startMs": 16740,
			"endMs": 19920
		},
		{
			"speaker": "讀者",
			"text": "九五飛龍在天,利見大人。",
			"startMs": 19920,
			"endMs": 23920
		},
		{
			"speaker": "讀者",
			"text": "上九亢龍有悔。",
			"startMs": 23920,
			"endMs": 26620
		},
		{
			"speaker": "讀者",
			"text": "用九見群龍无首,吉。",
			"startMs": 26620,
			"endMs": 30120
		}
	]
}
