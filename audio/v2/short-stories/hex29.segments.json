	"title": "第二十九卦 坎",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex29.mp3",
	"durationMs": 31080,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十九卦,坎。",
			"startMs": 0,
			"endMs": 1620
		},
		{
			"speaker": "說書人",
			"text": "習坎有孚,維心亨,行有尚。",
			"startMs": 1620,
			"endMs": 5360
		},
		{
			"speaker": "說書人",
			"text": "初六習坎,入于坎窞,凶。",
			"startMs": 5360,
			"endMs": 8660
		},
		{
			"speaker": "說書人",
			"text": "九二坎有險,求小得。",
			"startMs": 8660,
			"endMs": 11840
		},
		{
			"speaker": "說書人",
			"text": "六三來之坎坎,險且枕,入于坎窞,勿用。",
			"startMs": 11840,
			"endMs": 17120
		},
		{
			"speaker": "說書人",
			"text": "六四樽酒簋貳,用缶,納約自牖,終无咎。",
			"startMs": 17120,
			"endMs": 22160
		},
		{
			"speaker": "說書人",
			"text": "九五坎不盈,祗既平,无咎。",
			"startMs": 22160,
			"endMs": 25580
		},
		{
			"speaker": "說書人",
			"text": "上六係用徽纆,寘于叢棘,三歲不得,凶。",
			"startMs": 25580,
			"endMs": 31080
		}
	]
}
