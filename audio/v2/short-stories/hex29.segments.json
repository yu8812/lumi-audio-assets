	"slug": "hex29",
	"title": "第二十九卦 坎",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex29.mp3",
	"durationMs": 39520,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十九卦,坎。",
			"startMs": 0,
			"endMs": 2180
		},
		{
			"speaker": "說書人",
			"text": "習坎有孚,維心亨,行有尚。",
			"startMs": 2180,
			"endMs": 7120
		},
		{
			"speaker": "說書人",
			"text": "初六習坎,入于坎窞,凶。",
			"startMs": 7120,
			"endMs": 11780
		},
		{
			"speaker": "說書人",
			"text": "九二坎有險,求小得。",
			"startMs": 11780,
			"endMs": 15640
		},
		{
			"speaker": "說書人",
			"text": "六三來之坎坎,險且枕,入于坎窞,勿用。",
			"startMs": 15640,
			"endMs": 22080
		},
		{
			"speaker": "說書人",
			"text": "六四樽酒簋貳,用缶,納約自牖,終无咎。",
			"startMs": 22080,
			"endMs": 28520
		},
		{
			"speaker": "說書人",
			"text": "九五坎不盈,祗既平,无咎。",
			"startMs": 28520,
			"endMs": 33060
		},
		{
			"speaker": "說書人",
			"text": "上六係用徽纆,寘于叢棘,三歲不得,凶。",
			"startMs": 33060,
			"endMs": 39520
		}
	]
}
