	"segments": [
		{
			"speaker": "說書人",
			"text": "第五卦,需。",
			"startMs": 0,
			"endMs": 1660
		},
		{
			"speaker": "讀者",
			"text": "需有孚,光亨,貞吉。利涉大川。",
			"startMs": 1660,
			"endMs": 6580
		},
		{
			"speaker": "讀者",
			"text": "初九需于郊,利用恆,无咎。",
			"startMs": 6580,
			"endMs": 10800
		},
		{
			"speaker": "讀者",
			"text": "九二需于沙,小有言,終吉。",
			"startMs": 10800,
			"endMs": 15220
		},
		{
			"speaker": "讀者",
			"text": "九三需于泥,致寇至。",
			"startMs": 15220,
			"endMs": 18800
		},
		{
			"speaker": "讀者",
			"text": "六四需于血,出自穴。",
			"startMs": 18800,
			"endMs": 22380
		},
		{
			"speaker": "讀者",
			"text": "九五需于酒食,貞吉。",
			"startMs": 22380,
			"endMs": 26040
		},
		{
			"speaker": "讀者",
			"text": "上六入于穴,有不速之客三人來,敬之終吉。",
			"startMs": 26040,
			"endMs": 32200
		}
	]
}
