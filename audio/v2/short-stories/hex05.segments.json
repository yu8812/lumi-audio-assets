	"segments": [
		{
			"speaker": "說書人",
			"text": "第五卦,需。",
			"startMs": 0,
			"endMs": 1340
		},
		{
			"speaker": "說書人",
			"text": "需有孚,光亨,貞吉。利涉大川。",
			"startMs": 1340,
			"endMs": 6860
		},
		{
			"speaker": "說書人",
			"text": "初九需于郊,利用恆,无咎。",
			"startMs": 6860,
			"endMs": 11240
		},
		{
			"speaker": "說書人",
			"text": "九二需于沙,小有言,終吉。",
			"startMs": 11240,
			"endMs": 15780
		},
		{
			"speaker": "說書人",
			"text": "九三需于泥,致寇至。",
			"startMs": 15780,
			"endMs": 19440
		},
		{
			"speaker": "說書人",
			"text": "六四需于血,出自穴。",
			"startMs": 19440,
			"endMs": 23060
		},
		{
			"speaker": "說書人",
			"text": "九五需于酒食,貞吉。",
			"startMs": 23060,
			"endMs": 26840
		},
		{
			"speaker": "說書人",
			"text": "上六入于穴,有不速之客三人來,敬之終吉。",
			"startMs": 26840,
			"endMs": 33040
		}
	]
}
