	"segments": [
		{
			"speaker": "說書人",
			"text": "第五卦,需。",
			"startMs": 0,
			"endMs": 1620
		},
		{
			"speaker": "說書人",
			"text": "需有孚,光亨,貞吉。利涉大川。",
			"startMs": 1620,
			"endMs": 7300
		},
		{
			"speaker": "說書人",
			"text": "初九需于郊,利用恆,无咎。",
			"startMs": 7300,
			"endMs": 11640
		},
		{
			"speaker": "說書人",
			"text": "九二需于沙,小有言,終吉。",
			"startMs": 11640,
			"endMs": 16100
		},
		{
			"speaker": "說書人",
			"text": "九三需于泥,致寇至。",
			"startMs": 16100,
			"endMs": 20240
		},
		{
			"speaker": "說書人",
			"text": "六四需于血,出自穴。",
			"startMs": 20240,
			"endMs": 23900
		},
		{
			"speaker": "說書人",
			"text": "九五需于酒食,貞吉。",
			"startMs": 23900,
			"endMs": 27560
		},
		{
			"speaker": "說書人",
			"text": "上六入于穴,有不速之客三人來,敬之終吉。",
			"startMs": 27560,
			"endMs": 33880
		}
	]
}
