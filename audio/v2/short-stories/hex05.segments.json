	"segments": [
		{
			"speaker": "說書人",
			"text": "第五卦,需。",
			"startMs": 0,
			"endMs": 1460
		},
		{
			"speaker": "說書人",
			"text": "需有孚,光亨,貞吉。利涉大川。",
			"startMs": 1460,
			"endMs": 6100
		},
		{
			"speaker": "說書人",
			"text": "初九需于郊,利用恆,无咎。",
			"startMs": 6100,
			"endMs": 9840
		},
		{
			"speaker": "說書人",
			"text": "九二需于沙,小有言,終吉。",
			"startMs": 9840,
			"endMs": 13340
		},
		{
			"speaker": "說書人",
			"text": "九三需于泥,致寇至。",
			"startMs": 13340,
			"endMs": 16720
		},
		{
			"speaker": "說書人",
			"text": "六四需于血,出自穴。",
			"startMs": 16720,
			"endMs": 19900
		},
		{
			"speaker": "說書人",
			"text": "九五需于酒食,貞吉。",
			"startMs": 19900,
			"endMs": 23040
		},
		{
			"speaker": "說書人",
			"text": "上六入于穴,有不速之客三人來,敬之終吉。",
			"startMs": 23040,
			"endMs": 28320
		}
	]
}
