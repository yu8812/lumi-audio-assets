	"segments": [
		{
			"speaker": "說書人",
			"text": "第四十九卦,革。",
			"startMs": 0,
			"endMs": 2020
		},
		{
			"speaker": "說書人",
			"text": "革巳日乃孚,元亨利貞,悔亡。",
			"startMs": 2020,
			"endMs": 7620
		},
		{
			"speaker": "說書人",
			"text": "初九鞏用黃牛之革。",
			"startMs": 7620,
			"endMs": 11000
		},
		{
			"speaker": "說書人",
			"text": "六二巳日乃革之,征吉,无咎。",
			"startMs": 11000,
			"endMs": 15960
		},
		{
			"speaker": "說書人",
			"text": "九三征凶,貞厲。革言三就,有孚。",
			"startMs": 15960,
			"endMs": 21320
		},
		{
			"speaker": "說書人",
			"text": "九四悔亡,有孚改命,吉。",
			"startMs": 21320,
			"endMs": 25700
		},
		{
			"speaker": "說書人",
			"text": "九五大人虎變,未占有孚。",
			"startMs": 25700,
			"endMs": 29660
		},
		{
			"speaker": "說書人",
			"text": "上六君子豹變,小人革面,征吉,居貞吉。",
			"startMs": 29660,
			"endMs": 36080
		}
	]
}
