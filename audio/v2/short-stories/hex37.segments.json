	"segments": [
		{
			"speaker": "說書人",
			"text": "第三十七卦,家人。",
			"startMs": 0,
			"endMs": 2260
		},
		{
			"speaker": "讀者",
			"text": "家人利女貞。",
			"startMs": 2260,
			"endMs": 4800
		},
		{
			"speaker": "讀者",
			"text": "初九閑有家,悔亡。",
			"startMs": 4800,
			"endMs": 8180
		},
		{
			"speaker": "讀者",
			"text": "六二无攸遂,在中饋,貞吉。",
			"startMs": 8180,
			"endMs": 12440
		},
		{
			"speaker": "讀者",
			"text": "九三家人嗃嗃,悔厲吉;婦子嘻嘻,終吝。",
			"startMs": 12440,
			"endMs": 18080
		},
		{
			"speaker": "讀者",
			"text": "六四富家,大吉。",
			"startMs": 18080,
			"endMs": 21100
		},
		{
			"speaker": "讀者",
			"text": "九五王假有家,勿恤,吉。",
			"startMs": 21100,
			"endMs": 25140
		},
		{
			"speaker": "讀者",
			"text": "上九有孚威如,終吉。",
			"startMs": 25140,
			"endMs": 28440
		}
	]
}
