	"segments": [
		{
			"speaker": "說書人",
			"text": "第三十七卦,家人。",
			"startMs": 0,
			"endMs": 2420
		},
		{
			"speaker": "說書人",
			"text": "家人利女貞。",
			"startMs": 2420,
			"endMs": 4960
		},
		{
			"speaker": "說書人",
			"text": "初九閑有家,悔亡。",
			"startMs": 4960,
			"endMs": 8820
		},
		{
			"speaker": "說書人",
			"text": "六二无攸遂,在中饋,貞吉。",
			"startMs": 8820,
			"endMs": 13880
		},
		{
			"speaker": "說書人",
			"text": "九三家人嗃嗃,悔厲吉;婦子嘻嘻,終吝。",
			"startMs": 13880,
			"endMs": 20200
		},
		{
			"speaker": "說書人",
			"text": "六四富家,大吉。",
			"startMs": 20200,
			"endMs": 23140
		},
		{
			"speaker": "說書人",
			"text": "九五王假有家,勿恤,吉。",
			"startMs": 23140,
			"endMs": 27300
		},
		{
			"speaker": "說書人",
			"text": "上九有孚威如,終吉。",
			"startMs": 27300,
			"endMs": 31000
		}
	]
}
