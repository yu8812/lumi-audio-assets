	"segments": [
		{
			"speaker": "說書人",
			"text": "第三十七卦,家人。",
			"startMs": 0,
			"endMs": 2300
		},
		{
			"speaker": "說書人",
			"text": "家人利女貞。",
			"startMs": 2300,
			"endMs": 4680
		},
		{
			"speaker": "說書人",
			"text": "初九閑有家,悔亡。",
			"startMs": 4680,
			"endMs": 8100
		},
		{
			"speaker": "說書人",
			"text": "六二无攸遂,在中饋,貞吉。",
			"startMs": 8100,
			"endMs": 12440
		},
		{
			"speaker": "說書人",
			"text": "九三家人嗃嗃,悔厲吉;婦子嘻嘻,終吝。",
			"startMs": 12440,
			"endMs": 18560
		},
		{
			"speaker": "說書人",
			"text": "六四富家,大吉。",
			"startMs": 18560,
			"endMs": 21620
		},
		{
			"speaker": "說書人",
			"text": "九五王假有家,勿恤,吉。",
			"startMs": 21620,
			"endMs": 25980
		},
		{
			"speaker": "說書人",
			"text": "上九有孚威如,終吉。",
			"startMs": 25980,
			"endMs": 29640
		}
	]
}
