	"segments": [
		{
			"speaker": "說書人",
			"text": "第三十七卦,家人。",
			"startMs": 0,
			"endMs": 2020
		},
		{
			"speaker": "說書人",
			"text": "家人利女貞。",
			"startMs": 2020,
			"endMs": 4320
		},
		{
			"speaker": "說書人",
			"text": "初九閑有家,悔亡。",
			"startMs": 4320,
			"endMs": 7140
		},
		{
			"speaker": "說書人",
			"text": "六二无攸遂,在中饋,貞吉。",
			"startMs": 7140,
			"endMs": 11000
		},
		{
			"speaker": "說書人",
			"text": "九三家人嗃嗃,悔厲吉;婦子嘻嘻,終吝。",
			"startMs": 11000,
			"endMs": 15760
		},
		{
			"speaker": "說書人",
			"text": "六四富家,大吉。",
			"startMs": 15760,
			"endMs": 18620
		},
		{
			"speaker": "說書人",
			"text": "九五王假有家,勿恤,吉。",
			"startMs": 18620,
			"endMs": 22300
		},
		{
			"speaker": "說書人",
			"text": "上九有孚威如,終吉。",
			"startMs": 22300,
			"endMs": 25440
		}
	]
}
