{
	"slug": "hex63",
	"title": "第六十三卦 既濟",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex63.mp3",
	"durationMs": 34240,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第六十三卦,既濟。",
			"startMs": 0,
			"endMs": 2380
		},
		{
			"speaker": "說書人",
			"text": "既濟亨小,利貞。初吉終亂。",
			"startMs": 2380,
			"endMs": 6780
		},
		{
			"speaker": "說書人",
			"text": "初九曳其輪,濡其尾,无咎。",
			"startMs": 6780,
			"endMs": 11200
		},
		{
			"speaker": "說書人",
			"text": "六二婦喪其茀,勿逐,七日得。",
			"startMs": 11200,
			"endMs": 16120
		},
		{
			"speaker": "說書人",
			"text": "九三高宗伐鬼方,三年克之,小人勿用。",
			"startMs": 16120,
			"endMs": 21660
		},
		{
			"speaker": "說書人",
			"text": "六四繻有衣袽,終日戒。",
			"startMs": 21660,
			"endMs": 25320
		},
		{
			"speaker": "說書人",
			"text": "九五東鄰殺牛,不如西鄰之禴祭,實受其福。",
			"startMs": 25320,
			"endMs": 31660
		},
		{
			"speaker": "說書人",
			"text": "上六濡其首,厲。",
			"startMs": 31660,
			"endMs": 34240
		}
	]
}
