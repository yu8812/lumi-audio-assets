{
	"slug": "hex63",
	"title": "第六十三卦 既濟",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex63.mp3",
	"durationMs": 30440,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第六十三卦,既濟。",
			"startMs": 0,
			"endMs": 2060
		},
		{
			"speaker": "說書人",
			"text": "既濟亨小,利貞。初吉終亂。",
			"startMs": 2060,
			"endMs": 5820
		},
		{
			"speaker": "說書人",
			"text": "初九曳其輪,濡其尾,无咎。",
			"startMs": 5820,
			"endMs": 9400
		},
		{
			"speaker": "說書人",
			"text": "六二婦喪其茀,勿逐,七日得。",
			"startMs": 9400,
			"endMs": 13520
		},
		{
			"speaker": "說書人",
			"text": "九三高宗伐鬼方,三年克之,小人勿用。",
			"startMs": 13520,
			"endMs": 19060
		},
		{
			"speaker": "說書人",
			"text": "六四繻有衣袽,終日戒。",
			"startMs": 19060,
			"endMs": 22440
		},
		{
			"speaker": "說書人",
			"text": "九五東鄰殺牛,不如西鄰之禴祭,實受其福。",
			"startMs": 22440,
			"endMs": 27780
		},
		{
			"speaker": "說書人",
			"text": "上六濡其首,厲。",
			"startMs": 27780,
			"endMs": 30440
		}
	]
}
