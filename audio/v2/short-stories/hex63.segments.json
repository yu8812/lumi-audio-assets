{
	"slug": "hex63",
	"title": "第六十三卦 既濟",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex63.mp3",
	"durationMs": 37840,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第六十三卦,既濟。",
			"startMs": 0,
			"endMs": 3340
		},
		{
			"speaker": "說書人",
			"text": "既濟亨小,利貞。初吉終亂。",
			"startMs": 3340,
			"endMs": 7940
		},
		{
			"speaker": "說書人",
			"text": "初九曳其輪,濡其尾,无咎。",
			"startMs": 7940,
			"endMs": 12600
		},
		{
			"speaker": "說書人",
			"text": "六二婦喪其茀,勿逐,七日得。",
			"startMs": 12600,
			"endMs": 17960
		},
		{
			"speaker": "說書人",
			"text": "九三高宗伐鬼方,三年克之,小人勿用。",
			"startMs": 17960,
			"endMs": 24220
		},
		{
			"speaker": "說書人",
			"text": "六四繻有衣袽,終日戒。",
			"startMs": 24220,
			"endMs": 28080
		},
		{
			"speaker": "說書人",
			"text": "九五東鄰殺牛,不如西鄰之禴祭,實受其福。",
			"startMs": 28080,
			"endMs": 34980
		},
		{
			"speaker": "說書人",
			"text": "上六濡其首,厲。",
			"startMs": 34980,
			"endMs": 37840
		}
	]
}
