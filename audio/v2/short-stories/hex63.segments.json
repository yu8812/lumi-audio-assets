{
	"slug": "hex63",
	"title": "第六十三卦 既濟",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex63.mp3",
	"durationMs": 30440,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第六十三卦,既濟。",
			"startMs": 0,
			"endMs": 1940
		},
		{
			"speaker": "說書人",
			"text": "既濟亨小,利貞。初吉終亂。",
			"startMs": 1940,
			"endMs": 5860
		},
		{
			"speaker": "說書人",
			"text": "初九曳其輪,濡其尾,无咎。",
			"startMs": 5860,
			"endMs": 9120
		},
		{
			"speaker": "說書人",
			"text": "六二婦喪其茀,勿逐,七日得。",
			"startMs": 9120,
			"endMs": 13440
		},
		{
			"speaker": "說書人",
			"text": "九三高宗伐鬼方,三年克之,小人勿用。",
			"startMs": 13440,
			"endMs": 18940
		},
		{
			"speaker": "說書人",
			"text": "六四繻有衣袽,終日戒。",
			"startMs": 18940,
			"endMs": 22160
		},
		{
			"speaker": "說書人",
			"text": "九五東鄰殺牛,不如西鄰之禴祭,實受其福。",
			"startMs": 22160,
			"endMs": 27900
		},
		{
			"speaker": "說書人",
			"text": "上六濡其首,厲。",
			"startMs": 27900,
			"endMs": 30440
		}
	]
}
