	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十一卦,噬嗑。",
			"startMs": 0,
			"endMs": 2340
		},
		{
			"speaker": "讀者",
			"text": "噬嗑亨。利用獄。",
			"startMs": 2340,
			"endMs": 5600
		},
		{
			"speaker": "讀者",
			"text": "初九屨校滅趾,无咎。",
			"startMs": 5600,
			"endMs": 8740
		},
		{
			"speaker": "讀者",
			"text": "六二噬膚滅鼻,无咎。",
			"startMs": 8740,
			"endMs": 12080
		},
		{
			"speaker": "讀者",
			"text": "六三噬腊肉,遇毒。小吝,无咎。",
			"startMs": 12080,
			"endMs": 17480
		},
		{
			"speaker": "讀者",
			"text": "九四噬乾胏,得金矢。利艱貞,吉。",
			"startMs": 17480,
			"endMs": 22640
		},
		{
			"speaker": "讀者",
			"text": "六五噬乾肉,得黃金。貞厲,无咎。",
			"startMs": 22640,
			"endMs": 27640
		},
		{
			"speaker": "讀者",
			"text": "上九何校滅耳,凶。",
			"startMs": 27640,
			"endMs": 30580
		}
	]
}
