	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十一卦,噬嗑。",
			"startMs": 0,
			"endMs": 1900
		},
		{
			"speaker": "說書人",
			"text": "噬嗑亨。利用獄。",
			"startMs": 1900,
			"endMs": 4320
		},
		{
			"speaker": "說書人",
			"text": "初九屨校滅趾,无咎。",
			"startMs": 4320,
			"endMs": 7340
		},
		{
			"speaker": "說書人",
			"text": "六二噬膚滅鼻,无咎。",
			"startMs": 7340,
			"endMs": 10160
		},
		{
			"speaker": "說書人",
			"text": "六三噬腊肉,遇毒。小吝,无咎。",
			"startMs": 10160,
			"endMs": 14320
		},
		{
			"speaker": "說書人",
			"text": "九四噬乾胏,得金矢。利艱貞,吉。",
			"startMs": 14320,
			"endMs": 18960
		},
		{
			"speaker": "說書人",
			"text": "六五噬乾肉,得黃金。貞厲,无咎。",
			"startMs": 18960,
			"endMs": 23200
		},
		{
			"speaker": "說書人",
			"text": "上九何校滅耳,凶。",
			"startMs": 23200,
			"endMs": 26420
		}
	]
}
