	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十一卦,噬嗑。",
			"startMs": 0,
			"endMs": 2580
		},
		{
			"speaker": "說書人",
			"text": "噬嗑亨。利用獄。",
			"startMs": 2580,
			"endMs": 4640
		},
		{
			"speaker": "說書人",
			"text": "初九屨校滅趾,无咎。",
			"startMs": 4640,
			"endMs": 8060
		},
		{
			"speaker": "說書人",
			"text": "六二噬膚滅鼻,无咎。",
			"startMs": 8060,
			"endMs": 11560
		},
		{
			"speaker": "說書人",
			"text": "六三噬腊肉,遇毒。小吝,无咎。",
			"startMs": 11560,
			"endMs": 16680
		},
		{
			"speaker": "說書人",
			"text": "九四噬乾胏,得金矢。利艱貞,吉。",
			"startMs": 16680,
			"endMs": 22240
		},
		{
			"speaker": "說書人",
			"text": "六五噬乾肉,得黃金。貞厲,无咎。",
			"startMs": 22240,
			"endMs": 27880
		},
		{
			"speaker": "說書人",
			"text": "上九何校滅耳,凶。",
			"startMs": 27880,
			"endMs": 31140
		}
	]
}
