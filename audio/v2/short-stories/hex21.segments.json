	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十一卦,噬嗑。",
			"startMs": 0,
			"endMs": 1980
		},
		{
			"speaker": "說書人",
			"text": "噬嗑亨。利用獄。",
			"startMs": 1980,
			"endMs": 4440
		},
		{
			"speaker": "說書人",
			"text": "初九屨校滅趾,无咎。",
			"startMs": 4440,
			"endMs": 7420
		},
		{
			"speaker": "說書人",
			"text": "六二噬膚滅鼻,无咎。",
			"startMs": 7420,
			"endMs": 10400
		},
		{
			"speaker": "說書人",
			"text": "六三噬腊肉,遇毒。小吝,无咎。",
			"startMs": 10400,
			"endMs": 14320
		},
		{
			"speaker": "說書人",
			"text": "九四噬乾胏,得金矢。利艱貞,吉。",
			"startMs": 14320,
			"endMs": 19160
		},
		{
			"speaker": "說書人",
			"text": "六五噬乾肉,得黃金。貞厲,无咎。",
			"startMs": 19160,
			"endMs": 23320
		},
		{
			"speaker": "說書人",
			"text": "上九何校滅耳,凶。",
			"startMs": 23320,
			"endMs": 26300
		}
	]
}
