		{
			"speaker": "說書人",
			"text": "第十卦,履。",
			"startMs": 0,
			"endMs": 2260
		},
		{
			"speaker": "說書人",
			"text": "履虎尾,不咥人,亨。",
			"startMs": 2260,
			"endMs": 5000
		},
		{
			"speaker": "說書人",
			"text": "初九素履,往无咎。",
			"startMs": 5000,
			"endMs": 8460
		},
		{
			"speaker": "說書人",
			"text": "九二履道坦坦,幽人貞吉。",
			"startMs": 8460,
			"endMs": 12900
		},
		{
			"speaker": "說書人",
			"text": "六三眇能視,跛能履,履虎尾,咥人,凶。武人為于大君。",
			"startMs": 12900,
			"endMs": 21200
		},
		{
			"speaker": "說書人",
			"text": "九四履虎尾,愬愬,終吉。",
			"startMs": 21200,
			"endMs": 25700
		},
		{
			"speaker": "說書人",
			"text": "九五夬履,貞厲。",
			"startMs": 25700,
			"endMs": 27920
		},
		{
			"speaker": "說書人",
			"text": "上九視履考祥,其旋元吉。",
			"startMs": 27920,
			"endMs": 32480
		}
	]
}
