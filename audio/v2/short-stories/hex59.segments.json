	"slug": "hex59",
	"title": "第五十九卦 渙",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex59.mp3",
	"durationMs": 32340,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第五十九卦,渙。",
			"startMs": 0,
			"endMs": 2020
		},
		{
			"speaker": "讀者",
			"text": "渙亨。王假有廟,利涉大川,利貞。",
			"startMs": 2020,
			"endMs": 7740
		},
		{
			"speaker": "讀者",
			"text": "初六用拯馬壯,吉。",
			"startMs": 7740,
			"endMs": 10640
		},
		{
			"speaker": "讀者",
			"text": "九二渙奔其机,悔亡。",
			"startMs": 10640,
			"endMs": 14220
		},
		{
			"speaker": "讀者",
			"text": "六三渙其躬,无悔。",
			"startMs": 14220,
			"endMs": 17480
		},
		{
			"speaker": "讀者",
			"text": "六四渙其群,元吉。渙有丘,匪夷所思。",
			"startMs": 17480,
			"endMs": 23520
		},
		{
			"speaker": "讀者",
			"text": "九五渙汗其大號,渙王居,无咎。",
			"startMs": 23520,
			"endMs": 28120
		},
		{
			"speaker": "讀者",
			"text": "上九渙其血,去逖出,无咎。",
			"startMs": 28120,
			"endMs": 32340
		}
	]
}
