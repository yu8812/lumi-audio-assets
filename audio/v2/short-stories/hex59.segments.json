{
	"slug": "hex59",
	"title": "第五十九卦 渙",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex59.mp3",
	"durationMs": 33940,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第五十九卦,渙。",
			"startMs": 0,
			"endMs": 2220
		},
		{
			"speaker": "說書人",
			"text": "渙亨。王假有廟,利涉大川,利貞。",
			"startMs": 2220,
			"endMs": 8660
		},
		{
			"speaker": "說書人",
			"text": "初六用拯馬壯,吉。",
			"startMs": 8660,
			"endMs": 11480
		},
		{
			"speaker": "說書人",
			"text": "九二渙奔其机,悔亡。",
			"startMs": 11480,
			"endMs": 15260
		},
		{
			"speaker": "說書人",
			"text": "六三渙其躬,无悔。",
			"startMs": 15260,
			"endMs": 18000
		},
		{
			"speaker": "說書人",
			"text": "六四渙其群,元吉。渙有丘,匪夷所思。",
			"startMs": 18000,
			"endMs": 24280
		},
		{
			"speaker": "說書人",
			"text": "九五渙汗其大號,渙王居,无咎。",
			"startMs": 24280,
			"endMs": 29200
		},
		{
			"speaker": "說書人",
			"text": "上九渙其血,去逖出,无咎。",
			"startMs": 29200,
			"endMs": 33940
		}
	]
}
