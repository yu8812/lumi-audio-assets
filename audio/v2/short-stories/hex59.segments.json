{
	"slug": "hex59",
	"title": "第五十九卦 渙",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex59.mp3",
	"durationMs": 29340,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第五十九卦,渙。",
			"startMs": 0,
			"endMs": 1820
		},
		{
			"speaker": "說書人",
			"text": "渙亨。王假有廟,利涉大川,利貞。",
			"startMs": 1820,
			"endMs": 7060
		},
		{
			"speaker": "說書人",
			"text": "初六用拯馬壯,吉。",
			"startMs": 7060,
			"endMs": 9800
		},
		{
			"speaker": "說書人",
			"text": "九二渙奔其机,悔亡。",
			"startMs": 9800,
			"endMs": 13340
		},
		{
			"speaker": "說書人",
			"text": "六三渙其躬,无悔。",
			"startMs": 13340,
			"endMs": 16160
		},
		{
			"speaker": "說書人",
			"text": "六四渙其群,元吉。渙有丘,匪夷所思。",
			"startMs": 16160,
			"endMs": 21120
		},
		{
			"speaker": "說書人",
			"text": "九五渙汗其大號,渙王居,无咎。",
			"startMs": 21120,
			"endMs": 25400
		},
		{
			"speaker": "說書人",
			"text": "上九渙其血,去逖出,无咎。",
			"startMs": 25400,
			"endMs": 29340
		}
	]
}
