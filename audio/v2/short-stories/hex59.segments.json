{
	"slug": "hex59",
	"title": "第五十九卦 渙",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex59.mp3",
	"durationMs": 27540,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第五十九卦,渙。",
			"startMs": 0,
			"endMs": 1740
		},
		{
			"speaker": "說書人",
			"text": "渙亨。王假有廟,利涉大川,利貞。",
			"startMs": 1740,
			"endMs": 6140
		},
		{
			"speaker": "說書人",
			"text": "初六用拯馬壯,吉。",
			"startMs": 6140,
			"endMs": 9000
		},
		{
			"speaker": "說書人",
			"text": "九二渙奔其机,悔亡。",
			"startMs": 9000,
			"endMs": 11940
		},
		{
			"speaker": "說書人",
			"text": "六三渙其躬,无悔。",
			"startMs": 11940,
			"endMs": 14680
		},
		{
			"speaker": "說書人",
			"text": "六四渙其群,元吉。渙有丘,匪夷所思。",
			"startMs": 14680,
			"endMs": 19480
		},
		{
			"speaker": "說書人",
			"text": "九五渙汗其大號,渙王居,无咎。",
			"startMs": 19480,
			"endMs": 23680
		},
		{
			"speaker": "說書人",
			"text": "上九渙其血,去逖出,无咎。",
			"startMs": 23680,
			"endMs": 27540
		}
	]
}
