{
	"slug": "hex59",
	"title": "第五十九卦 渙",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex59.mp3",
	"durationMs": 33820,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第五十九卦,渙。",
			"startMs": 0,
			"endMs": 2140
		},
		{
			"speaker": "說書人",
			"text": "渙亨。王假有廟,利涉大川,利貞。",
			"startMs": 2140,
			"endMs": 7980
		},
		{
			"speaker": "說書人",
			"text": "初六用拯馬壯,吉。",
			"startMs": 7980,
			"endMs": 11080
		},
		{
			"speaker": "說書人",
			"text": "九二渙奔其机,悔亡。",
			"startMs": 11080,
			"endMs": 15260
		},
		{
			"speaker": "說書人",
			"text": "六三渙其躬,无悔。",
			"startMs": 15260,
			"endMs": 18480
		},
		{
			"speaker": "說書人",
			"text": "六四渙其群,元吉。渙有丘,匪夷所思。",
			"startMs": 18480,
			"endMs": 24760
		},
		{
			"speaker": "說書人",
			"text": "九五渙汗其大號,渙王居,无咎。",
			"startMs": 24760,
			"endMs": 29280
		},
		{
			"speaker": "說書人",
			"text": "上九渙其血,去逖出,无咎。",
			"startMs": 29280,
			"endMs": 33820
		}
	]
}
