	"title": "第五十七卦 巽",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex57.mp3",
	"durationMs": 31900,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第五十七卦,巽。",
			"startMs": 0,
			"endMs": 1940
		},
		{
			"speaker": "說書人",
			"text": "巽小亨,利有攸往,利見大人。",
			"startMs": 1940,
			"endMs": 6100
		},
		{
			"speaker": "說書人",
			"text": "初六進退,利武人之貞。",
			"startMs": 6100,
			"endMs": 9520
		},
		{
			"speaker": "說書人",
			"text": "九二巽在床下,用史巫紛若,吉,无咎。",
			"startMs": 9520,
			"endMs": 14620
		},
		{
			"speaker": "說書人",
			"text": "九三頻巽,吝。",
			"startMs": 14620,
			"endMs": 17080
		},
		{
			"speaker": "說書人",
			"text": "六四悔亡,田獲三品。",
			"startMs": 17080,
			"endMs": 19900
		},
		{
			"speaker": "說書人",
			"text": "九五貞吉,悔亡,无不利。无初有終。先庚三日,後庚三日,吉。",
			"startMs": 19900,
			"endMs": 27340
		},
		{
			"speaker": "說書人",
			"text": "上九巽在床下,喪其資斧,貞凶。",
			"startMs": 27340,
			"endMs": 31900
		}
	]
}
