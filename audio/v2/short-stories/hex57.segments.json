	"slug": "hex57",
	"title": "第五十七卦 巽",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex57.mp3",
	"durationMs": 36260,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第五十七卦,巽。",
			"startMs": 0,
			"endMs": 1980
		},
		{
			"speaker": "讀者",
			"text": "巽小亨,利有攸往,利見大人。",
			"startMs": 1980,
			"endMs": 6460
		},
		{
			"speaker": "讀者",
			"text": "初六進退,利武人之貞。",
			"startMs": 6460,
			"endMs": 10280
		},
		{
			"speaker": "讀者",
			"text": "九二巽在床下,用史巫紛若,吉,无咎。",
			"startMs": 10280,
			"endMs": 16220
		},
		{
			"speaker": "讀者",
			"text": "九三頻巽,吝。",
			"startMs": 16220,
			"endMs": 18800
		},
		{
			"speaker": "讀者",
			"text": "六四悔亡,田獲三品。",
			"startMs": 18800,
			"endMs": 22220
		},
		{
			"speaker": "讀者",
			"text": "九五貞吉,悔亡,无不利。无初有終。先庚三日,後庚三日,吉。",
			"startMs": 22220,
			"endMs": 31100
		},
		{
			"speaker": "讀者",
			"text": "上九巽在床下,喪其資斧,貞凶。",
			"startMs": 31100,
			"endMs": 36260
		}
	]
}
