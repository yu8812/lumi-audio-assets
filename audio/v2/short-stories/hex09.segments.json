	"slug": "hex09",
	"title": "第九卦 小畜",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex09.mp3",
	"durationMs": 28160,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第九卦,小畜。",
			"startMs": 0,
			"endMs": 1540
		},
		{
			"speaker": "說書人",
			"text": "小畜亨。密雲不雨,自我西郊。",
			"startMs": 1540,
			"endMs": 5620
		},
		{
			"speaker": "說書人",
			"text": "初九復自道,何其咎?吉。",
			"startMs": 5620,
			"endMs": 8800
		},
		{
			"speaker": "說書人",
			"text": "九二牽復,吉。",
			"startMs": 8800,
			"endMs": 11060
		},
		{
			"speaker": "說書人",
			"text": "九三輿說輻,夫妻反目。",
			"startMs": 11060,
			"endMs": 14560
		},
		{
			"speaker": "說書人",
			"text": "六四有孚,血去惕出,无咎。",
			"startMs": 14560,
			"endMs": 17900
		},
		{
			"speaker": "說書人",
			"text": "九五有孚攣如,富以其鄰。",
			"startMs": 17900,
			"endMs": 21700
		},
		{
			"speaker": "說書人",
			"text": "上九既雨既處,尚德載,婦貞厲。月幾望,君子征凶。",
			"startMs": 21700,
			"endMs": 28160
		}
	]
}
