	"segments": [
		{
			"speaker": "說書人",
			"text": "第九卦,小畜。",
			"startMs": 0,
			"endMs": 2260
		},
		{
			"speaker": "說書人",
			"text": "小畜亨。密雲不雨,自我西郊。",
			"startMs": 2260,
			"endMs": 7540
		},
		{
			"speaker": "說書人",
			"text": "初九復自道,何其咎?吉。",
			"startMs": 7540,
			"endMs": 11600
		},
		{
			"speaker": "說書人",
			"text": "九二牽復,吉。",
			"startMs": 11600,
			"endMs": 13980
		},
		{
			"speaker": "說書人",
			"text": "九三輿說輻,夫妻反目。",
			"startMs": 13980,
			"endMs": 17640
		},
		{
			"speaker": "說書人",
			"text": "六四有孚,血去惕出,无咎。",
			"startMs": 17640,
			"endMs": 22140
		},
		{
			"speaker": "說書人",
			"text": "九五有孚攣如,富以其鄰。",
			"startMs": 22140,
			"endMs": 26300
		},
		{
			"speaker": "說書人",
			"text": "上九既雨既處,尚德載,婦貞厲。月幾望,君子征凶。",
			"startMs": 26300,
			"endMs": 33840
		}
	]
}
