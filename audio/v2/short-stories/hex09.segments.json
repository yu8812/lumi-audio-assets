	"slug": "hex09",
	"title": "第九卦 小畜",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex09.mp3",
	"durationMs": 32920,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第九卦,小畜。",
			"startMs": 0,
			"endMs": 2180
		},
		{
			"speaker": "讀者",
			"text": "小畜亨。密雲不雨,自我西郊。",
			"startMs": 2180,
			"endMs": 7060
		},
		{
			"speaker": "讀者",
			"text": "初九復自道,何其咎?吉。",
			"startMs": 7060,
			"endMs": 11040
		},
		{
			"speaker": "讀者",
			"text": "九二牽復,吉。",
			"startMs": 11040,
			"endMs": 13700
		},
		{
			"speaker": "讀者",
			"text": "九三輿說輻,夫妻反目。",
			"startMs": 13700,
			"endMs": 17360
		},
		{
			"speaker": "讀者",
			"text": "六四有孚,血去惕出,无咎。",
			"startMs": 17360,
			"endMs": 21380
		},
		{
			"speaker": "讀者",
			"text": "九五有孚攣如,富以其鄰。",
			"startMs": 21380,
			"endMs": 25380
		},
		{
			"speaker": "讀者",
			"text": "上九既雨既處,尚德載,婦貞厲。月幾望,君子征凶。",
			"startMs": 25380,
			"endMs": 32920
		}
	]
}
