{
	"slug": "hex25",
	"title": "第二十五卦 无妄",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex25.mp3",
	"durationMs": 34180,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十五卦,无妄。",
			"startMs": 0,
			"endMs": 2140
		},
		{
			"speaker": "說書人",
			"text": "无妄元亨利貞。其匪正有眚,不利有攸往。",
			"startMs": 2140,
			"endMs": 7840
		},
		{
			"speaker": "說書人",
			"text": "初九无妄,往吉。",
			"startMs": 7840,
			"endMs": 11020
		},
		{
			"speaker": "說書人",
			"text": "六二不耕穫,不菑畬,則利有攸往。",
			"startMs": 11020,
			"endMs": 16100
		},
		{
			"speaker": "說書人",
			"text": "六三无妄之災,或繫之牛,行人之得,邑人之災。",
			"startMs": 16100,
			"endMs": 22700
		},
		{
			"speaker": "說書人",
			"text": "九四可貞,无咎。",
			"startMs": 22700,
			"endMs": 25680
		},
		{
			"speaker": "說書人",
			"text": "九五无妄之疾,勿藥有喜。",
			"startMs": 25680,
			"endMs": 29720
		},
		{
			"speaker": "說書人",
			"text": "上九无妄,行有眚,无攸利。",
			"startMs": 29720,
			"endMs": 34180
		}
	]
}
