	"segments": [
		{
			"speaker": "說書人",
			"text": "第八卦,比。",
			"startMs": 0,
			"endMs": 1460
		},
		{
			"speaker": "說書人",
			"text": "比吉。原筮,元永貞,无咎。不寧方來,後夫凶。",
			"startMs": 1460,
			"endMs": 9040
		},
		{
			"speaker": "說書人",
			"text": "初六有孚比之,无咎。有孚盈缶,終來有它,吉。",
			"startMs": 9040,
			"endMs": 16220
		},
		{
			"speaker": "說書人",
			"text": "六二比之自內,貞吉。",
			"startMs": 16220,
			"endMs": 20080
		},
		{
			"speaker": "說書人",
			"text": "六三比之匪人。",
			"startMs": 20080,
			"endMs": 22900
		},
		{
			"speaker": "說書人",
			"text": "六四外比之,貞吉。",
			"startMs": 22900,
			"endMs": 26320
		},
		{
			"speaker": "說書人",
			"text": "九五顯比。王用三驅,失前禽,邑人不誡,吉。",
			"startMs": 26320,
			"endMs": 33560
		},
		{
			"speaker": "說書人",
			"text": "上六比之无首,凶。",
			"startMs": 33560,
			"endMs": 36580
		}
	]
}
