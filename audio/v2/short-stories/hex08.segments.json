	"segments": [
		{
			"speaker": "說書人",
			"text": "第八卦,比。",
			"startMs": 0,
			"endMs": 1260
		},
		{
			"speaker": "說書人",
			"text": "比吉。原筮,元永貞,无咎。不寧方來,後夫凶。",
			"startMs": 1260,
			"endMs": 7560
		},
		{
			"speaker": "說書人",
			"text": "初六有孚比之,无咎。有孚盈缶,終來有它,吉。",
			"startMs": 7560,
			"endMs": 13980
		},
		{
			"speaker": "說書人",
			"text": "六二比之自內,貞吉。",
			"startMs": 13980,
			"endMs": 17080
		},
		{
			"speaker": "說書人",
			"text": "六三比之匪人。",
			"startMs": 17080,
			"endMs": 19580
		},
		{
			"speaker": "說書人",
			"text": "六四外比之,貞吉。",
			"startMs": 19580,
			"endMs": 22640
		},
		{
			"speaker": "說書人",
			"text": "九五顯比。王用三驅,失前禽,邑人不誡,吉。",
			"startMs": 22640,
			"endMs": 27960
		},
		{
			"speaker": "說書人",
			"text": "上六比之无首,凶。",
			"startMs": 27960,
			"endMs": 30740
		}
	]
}
