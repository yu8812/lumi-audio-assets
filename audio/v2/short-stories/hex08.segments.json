	"segments": [
		{
			"speaker": "說書人",
			"text": "第八卦,比。",
			"startMs": 0,
			"endMs": 1300
		},
		{
			"speaker": "說書人",
			"text": "比吉。原筮,元永貞,无咎。不寧方來,後夫凶。",
			"startMs": 1300,
			"endMs": 8040
		},
		{
			"speaker": "說書人",
			"text": "初六有孚比之,无咎。有孚盈缶,終來有它,吉。",
			"startMs": 8040,
			"endMs": 13660
		},
		{
			"speaker": "說書人",
			"text": "六二比之自內,貞吉。",
			"startMs": 13660,
			"endMs": 16640
		},
		{
			"speaker": "說書人",
			"text": "六三比之匪人。",
			"startMs": 16640,
			"endMs": 19100
		},
		{
			"speaker": "說書人",
			"text": "六四外比之,貞吉。",
			"startMs": 19100,
			"endMs": 21920
		},
		{
			"speaker": "說書人",
			"text": "九五顯比。王用三驅,失前禽,邑人不誡,吉。",
			"startMs": 21920,
			"endMs": 27160
		},
		{
			"speaker": "說書人",
			"text": "上六比之无首,凶。",
			"startMs": 27160,
			"endMs": 29860
		}
	]
}
