	"segments": [
		{
			"speaker": "說書人",
			"text": "第八卦,比。",
			"startMs": 0,
			"endMs": 1700
		},
		{
			"speaker": "說書人",
			"text": "比吉。原筮,元永貞,无咎。不寧方來,後夫凶。",
			"startMs": 1700,
			"endMs": 8960
		},
		{
			"speaker": "說書人",
			"text": "初六有孚比之,无咎。有孚盈缶,終來有它,吉。",
			"startMs": 8960,
			"endMs": 15980
		},
		{
			"speaker": "說書人",
			"text": "六二比之自內,貞吉。",
			"startMs": 15980,
			"endMs": 19320
		},
		{
			"speaker": "說書人",
			"text": "六三比之匪人。",
			"startMs": 19320,
			"endMs": 21900
		},
		{
			"speaker": "說書人",
			"text": "六四外比之,貞吉。",
			"startMs": 21900,
			"endMs": 25160
		},
		{
			"speaker": "說書人",
			"text": "九五顯比。王用三驅,失前禽,邑人不誡,吉。",
			"startMs": 25160,
			"endMs": 32320
		},
		{
			"speaker": "說書人",
			"text": "上六比之无首,凶。",
			"startMs": 32320,
			"endMs": 35380
		}
	]
}
