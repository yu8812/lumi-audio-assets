	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十六卦,大畜。",
			"startMs": 0,
			"endMs": 2220
		},
		{
			"speaker": "說書人",
			"text": "大畜利貞。不家食吉,利涉大川。",
			"startMs": 2220,
			"endMs": 7220
		},
		{
			"speaker": "說書人",
			"text": "初九有厲,利已。",
			"startMs": 7220,
			"endMs": 10160
		},
		{
			"speaker": "說書人",
			"text": "九二輿說輹。",
			"startMs": 10160,
			"endMs": 12420
		},
		{
			"speaker": "說書人",
			"text": "九三良馬逐,利艱貞。曰閑輿衛,利有攸往。",
			"startMs": 12420,
			"endMs": 18880
		},
		{
			"speaker": "說書人",
			"text": "六四童牛之牿,元吉。",
			"startMs": 18880,
			"endMs": 22020
		},
		{
			"speaker": "說書人",
			"text": "六五豶豕之牙,吉。",
			"startMs": 22020,
			"endMs": 25360
		},
		{
			"speaker": "說書人",
			"text": "上九何天之衢,亨。",
			"startMs": 25360,
			"endMs": 28780
		}
	]
}
