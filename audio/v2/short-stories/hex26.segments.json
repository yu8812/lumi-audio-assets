	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十六卦,大畜。",
			"startMs": 0,
			"endMs": 1940
		},
		{
			"speaker": "說書人",
			"text": "大畜利貞。不家食吉,利涉大川。",
			"startMs": 1940,
			"endMs": 6340
		},
		{
			"speaker": "說書人",
			"text": "初九有厲,利已。",
			"startMs": 6340,
			"endMs": 9040
		},
		{
			"speaker": "說書人",
			"text": "九二輿說輹。",
			"startMs": 9040,
			"endMs": 11340
		},
		{
			"speaker": "說書人",
			"text": "九三良馬逐,利艱貞。曰閑輿衛,利有攸往。",
			"startMs": 11340,
			"endMs": 16800
		},
		{
			"speaker": "說書人",
			"text": "六四童牛之牿,元吉。",
			"startMs": 16800,
			"endMs": 19660
		},
		{
			"speaker": "說書人",
			"text": "六五豶豕之牙,吉。",
			"startMs": 19660,
			"endMs": 22400
		},
		{
			"speaker": "說書人",
			"text": "上九何天之衢,亨。",
			"startMs": 22400,
			"endMs": 25380
		}
	]
}
