	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十六卦,大畜。",
			"startMs": 0,
			"endMs": 2340
		},
		{
			"speaker": "讀者",
			"text": "大畜利貞。不家食吉,利涉大川。",
			"startMs": 2340,
			"endMs": 7020
		},
		{
			"speaker": "讀者",
			"text": "初九有厲,利已。",
			"startMs": 7020,
			"endMs": 9880
		},
		{
			"speaker": "讀者",
			"text": "九二輿說輹。",
			"startMs": 9880,
			"endMs": 12260
		},
		{
			"speaker": "讀者",
			"text": "九三良馬逐,利艱貞。曰閑輿衛,利有攸往。",
			"startMs": 12260,
			"endMs": 18680
		},
		{
			"speaker": "讀者",
			"text": "六四童牛之牿,元吉。",
			"startMs": 18680,
			"endMs": 22020
		},
		{
			"speaker": "讀者",
			"text": "六五豶豕之牙,吉。",
			"startMs": 22020,
			"endMs": 25000
		},
		{
			"speaker": "讀者",
			"text": "上九何天之衢,亨。",
			"startMs": 25000,
			"endMs": 28580
		}
	]
}
