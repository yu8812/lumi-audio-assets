		{
			"speaker": "說書人",
			"text": "第十九卦,臨。",
			"startMs": 0,
			"endMs": 2060
		},
		{
			"speaker": "說書人",
			"text": "臨元亨利貞。至于八月有凶。",
			"startMs": 2060,
			"endMs": 6300
		},
		{
			"speaker": "說書人",
			"text": "初九咸臨,貞吉。",
			"startMs": 6300,
			"endMs": 9040
		},
		{
			"speaker": "說書人",
			"text": "九二咸臨,吉,无不利。",
			"startMs": 9040,
			"endMs": 12860
		},
		{
			"speaker": "說書人",
			"text": "六三甘臨,无攸利。既憂之,无咎。",
			"startMs": 12860,
			"endMs": 18060
		},
		{
			"speaker": "說書人",
			"text": "六四至臨,无咎。",
			"startMs": 18060,
			"endMs": 21040
		},
		{
			"speaker": "說書人",
			"text": "六五知臨,大君之宜,吉。",
			"startMs": 21040,
			"endMs": 25260
		},
		{
			"speaker": "說書人",
			"text": "上六敦臨,吉,无咎。",
			"startMs": 25260,
			"endMs": 29080
		}
	]
}
