		{
			"speaker": "說書人",
			"text": "第十九卦,臨。",
			"startMs": 0,
			"endMs": 1660
		},
		{
			"speaker": "說書人",
			"text": "臨元亨利貞。至于八月有凶。",
			"startMs": 1660,
			"endMs": 5580
		},
		{
			"speaker": "說書人",
			"text": "初九咸臨,貞吉。",
			"startMs": 5580,
			"endMs": 8360
		},
		{
			"speaker": "說書人",
			"text": "九二咸臨,吉,无不利。",
			"startMs": 8360,
			"endMs": 11380
		},
		{
			"speaker": "說書人",
			"text": "六三甘臨,无攸利。既憂之,无咎。",
			"startMs": 11380,
			"endMs": 15660
		},
		{
			"speaker": "說書人",
			"text": "六四至臨,无咎。",
			"startMs": 15660,
			"endMs": 18200
		},
		{
			"speaker": "說書人",
			"text": "六五知臨,大君之宜,吉。",
			"startMs": 18200,
			"endMs": 21260
		},
		{
			"speaker": "說書人",
			"text": "上六敦臨,吉,无咎。",
			"startMs": 21260,
			"endMs": 24480
		}
	]
}
