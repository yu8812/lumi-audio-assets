	"segments": [
		{
			"speaker": "說書人",
			"text": "第十六卦,豫。",
			"startMs": 0,
			"endMs": 1860
		},
		{
			"speaker": "說書人",
			"text": "豫利建侯行師。",
			"startMs": 1860,
			"endMs": 4680
		},
		{
			"speaker": "說書人",
			"text": "初六鳴豫,凶。",
			"startMs": 4680,
			"endMs": 6900
		},
		{
			"speaker": "說書人",
			"text": "六二介于石,不終日,貞吉。",
			"startMs": 6900,
			"endMs": 10920
		},
		{
			"speaker": "說書人",
			"text": "六三盱豫,悔。遲有悔。",
			"startMs": 10920,
			"endMs": 14900
		},
		{
			"speaker": "說書人",
			"text": "九四由豫,大有得。勿疑,朋盍簪。",
			"startMs": 14900,
			"endMs": 19820
		},
		{
			"speaker": "說書人",
			"text": "六五貞疾,恆不死。",
			"startMs": 19820,
			"endMs": 23200
		},
		{
			"speaker": "說書人",
			"text": "上六冥豫,成有渝,无咎。",
			"startMs": 23200,
			"endMs": 27340
		}
	]
}
