	"segments": [
		{
			"speaker": "說書人",
			"text": "第十六卦,豫。",
			"startMs": 0,
			"endMs": 1580
		},
		{
			"speaker": "說書人",
			"text": "豫利建侯行師。",
			"startMs": 1580,
			"endMs": 4280
		},
		{
			"speaker": "說書人",
			"text": "初六鳴豫,凶。",
			"startMs": 4280,
			"endMs": 6740
		},
		{
			"speaker": "說書人",
			"text": "六二介于石,不終日,貞吉。",
			"startMs": 6740,
			"endMs": 10400
		},
		{
			"speaker": "說書人",
			"text": "六三盱豫,悔。遲有悔。",
			"startMs": 10400,
			"endMs": 14220
		},
		{
			"speaker": "說書人",
			"text": "九四由豫,大有得。勿疑,朋盍簪。",
			"startMs": 14220,
			"endMs": 18780
		},
		{
			"speaker": "說書人",
			"text": "六五貞疾,恆不死。",
			"startMs": 18780,
			"endMs": 21920
		},
		{
			"speaker": "說書人",
			"text": "上六冥豫,成有渝,无咎。",
			"startMs": 21920,
			"endMs": 25740
		}
	]
}
