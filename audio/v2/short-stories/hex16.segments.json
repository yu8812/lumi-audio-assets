	"segments": [
		{
			"speaker": "說書人",
			"text": "第十六卦,豫。",
			"startMs": 0,
			"endMs": 1340
		},
		{
			"speaker": "說書人",
			"text": "豫利建侯行師。",
			"startMs": 1340,
			"endMs": 4080
		},
		{
			"speaker": "說書人",
			"text": "初六鳴豫,凶。",
			"startMs": 4080,
			"endMs": 6340
		},
		{
			"speaker": "說書人",
			"text": "六二介于石,不終日,貞吉。",
			"startMs": 6340,
			"endMs": 9520
		},
		{
			"speaker": "說書人",
			"text": "六三盱豫,悔。遲有悔。",
			"startMs": 9520,
			"endMs": 12420
		},
		{
			"speaker": "說書人",
			"text": "九四由豫,大有得。勿疑,朋盍簪。",
			"startMs": 12420,
			"endMs": 16700
		},
		{
			"speaker": "說書人",
			"text": "六五貞疾,恆不死。",
			"startMs": 16700,
			"endMs": 19600
		},
		{
			"speaker": "說書人",
			"text": "上六冥豫,成有渝,无咎。",
			"startMs": 19600,
			"endMs": 22820
		}
	]
}
