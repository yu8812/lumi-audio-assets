	"segments": [
		{
			"speaker": "說書人",
			"text": "第十六卦,豫。",
			"startMs": 0,
			"endMs": 1860
		},
		{
			"speaker": "讀者",
			"text": "豫利建侯行師。",
			"startMs": 1860,
			"endMs": 4720
		},
		{
			"speaker": "讀者",
			"text": "初六鳴豫,凶。",
			"startMs": 4720,
			"endMs": 7180
		},
		{
			"speaker": "讀者",
			"text": "六二介于石,不終日,貞吉。",
			"startMs": 7180,
			"endMs": 11360
		},
		{
			"speaker": "讀者",
			"text": "六三盱豫,悔。遲有悔。",
			"startMs": 11360,
			"endMs": 15420
		},
		{
			"speaker": "讀者",
			"text": "九四由豫,大有得。勿疑,朋盍簪。",
			"startMs": 15420,
			"endMs": 20700
		},
		{
			"speaker": "讀者",
			"text": "六五貞疾,恆不死。",
			"startMs": 20700,
			"endMs": 23720
		},
		{
			"speaker": "讀者",
			"text": "上六冥豫,成有渝,无咎。",
			"startMs": 23720,
			"endMs": 27860
		}
	]
}
