	"segments": [
		{
			"speaker": "說書人",
			"text": "第三十一卦,咸。",
			"startMs": 0,
			"endMs": 2060
		},
		{
			"speaker": "說書人",
			"text": "咸亨,利貞,取女吉。",
			"startMs": 2060,
			"endMs": 5880
		},
		{
			"speaker": "說書人",
			"text": "初六咸其拇。",
			"startMs": 5880,
			"endMs": 8260
		},
		{
			"speaker": "說書人",
			"text": "六二咸其腓,凶,居吉。",
			"startMs": 8260,
			"endMs": 12440
		},
		{
			"speaker": "說書人",
			"text": "九三咸其股,執其隨,往吝。",
			"startMs": 12440,
			"endMs": 17020
		},
		{
			"speaker": "說書人",
			"text": "九四貞吉,悔亡。憧憧往來,朋從爾思。",
			"startMs": 17020,
			"endMs": 23000
		},
		{
			"speaker": "說書人",
			"text": "九五咸其脢,无悔。",
			"startMs": 23000,
			"endMs": 25980
		},
		{
			"speaker": "說書人",
			"text": "上六咸其輔頰舌。",
			"startMs": 25980,
			"endMs": 29040
		}
	]
}
