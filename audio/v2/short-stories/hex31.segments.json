	"segments": [
		{
			"speaker": "說書人",
			"text": "第三十一卦,咸。",
			"startMs": 0,
			"endMs": 1660
		},
		{
			"speaker": "說書人",
			"text": "咸亨,利貞,取女吉。",
			"startMs": 1660,
			"endMs": 4840
		},
		{
			"speaker": "說書人",
			"text": "初六咸其拇。",
			"startMs": 4840,
			"endMs": 7260
		},
		{
			"speaker": "說書人",
			"text": "六二咸其腓,凶,居吉。",
			"startMs": 7260,
			"endMs": 10320
		},
		{
			"speaker": "說書人",
			"text": "九三咸其股,執其隨,往吝。",
			"startMs": 10320,
			"endMs": 13700
		},
		{
			"speaker": "說書人",
			"text": "九四貞吉,悔亡。憧憧往來,朋從爾思。",
			"startMs": 13700,
			"endMs": 19040
		},
		{
			"speaker": "說書人",
			"text": "九五咸其脢,无悔。",
			"startMs": 19040,
			"endMs": 21780
		},
		{
			"speaker": "說書人",
			"text": "上六咸其輔頰舌。",
			"startMs": 21780,
			"endMs": 24600
		}
	]
}
