	"segments": [
		{
			"speaker": "說書人",
			"text": "第三十一卦,咸。",
			"startMs": 0,
			"endMs": 1820
		},
		{
			"speaker": "說書人",
			"text": "咸亨,利貞,取女吉。",
			"startMs": 1820,
			"endMs": 4880
		},
		{
			"speaker": "說書人",
			"text": "初六咸其拇。",
			"startMs": 4880,
			"endMs": 7300
		},
		{
			"speaker": "說書人",
			"text": "六二咸其腓,凶,居吉。",
			"startMs": 7300,
			"endMs": 11240
		},
		{
			"speaker": "說書人",
			"text": "九三咸其股,執其隨,往吝。",
			"startMs": 11240,
			"endMs": 14980
		},
		{
			"speaker": "說書人",
			"text": "九四貞吉,悔亡。憧憧往來,朋從爾思。",
			"startMs": 14980,
			"endMs": 20400
		},
		{
			"speaker": "說書人",
			"text": "九五咸其脢,无悔。",
			"startMs": 20400,
			"endMs": 23020
		},
		{
			"speaker": "說書人",
			"text": "上六咸其輔頰舌。",
			"startMs": 23020,
			"endMs": 26160
		}
	]
}
