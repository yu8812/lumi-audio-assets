	"segments": [
		{
			"speaker": "說書人",
			"text": "第三十一卦,咸。",
			"startMs": 0,
			"endMs": 2340
		},
		{
			"speaker": "說書人",
			"text": "咸亨,利貞,取女吉。",
			"startMs": 2340,
			"endMs": 6320
		},
		{
			"speaker": "說書人",
			"text": "初六咸其拇。",
			"startMs": 6320,
			"endMs": 8780
		},
		{
			"speaker": "說書人",
			"text": "六二咸其腓,凶,居吉。",
			"startMs": 8780,
			"endMs": 13080
		},
		{
			"speaker": "說書人",
			"text": "九三咸其股,執其隨,往吝。",
			"startMs": 13080,
			"endMs": 17980
		},
		{
			"speaker": "說書人",
			"text": "九四貞吉,悔亡。憧憧往來,朋從爾思。",
			"startMs": 17980,
			"endMs": 24600
		},
		{
			"speaker": "說書人",
			"text": "九五咸其脢,无悔。",
			"startMs": 24600,
			"endMs": 27500
		},
		{
			"speaker": "說書人",
			"text": "上六咸其輔頰舌。",
			"startMs": 27500,
			"endMs": 30920
		}
	]
}
