	"title": "第三十一卦 咸",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex31.mp3",
	"durationMs": 29160,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第三十一卦,咸。",
			"startMs": 0,
			"endMs": 2260
		},
		{
			"speaker": "讀者",
			"text": "咸亨,利貞,取女吉。",
			"startMs": 2260,
			"endMs": 5560
		},
		{
			"speaker": "讀者",
			"text": "初六咸其拇。",
			"startMs": 5560,
			"endMs": 8020
		},
		{
			"speaker": "讀者",
			"text": "六二咸其腓,凶,居吉。",
			"startMs": 8020,
			"endMs": 11800
		},
		{
			"speaker": "讀者",
			"text": "九三咸其股,執其隨,往吝。",
			"startMs": 11800,
			"endMs": 16260
		},
		{
			"speaker": "讀者",
			"text": "九四貞吉,悔亡。憧憧往來,朋從爾思。",
			"startMs": 16260,
			"endMs": 22720
		},
		{
			"speaker": "讀者",
			"text": "九五咸其脢,无悔。",
			"startMs": 22720,
			"endMs": 25940
		},
		{
			"speaker": "讀者",
			"text": "上六咸其輔頰舌。",
			"startMs": 25940,
			"endMs": 29160
		}
	]
}
