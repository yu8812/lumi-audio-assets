		{
			"speaker": "說書人",
			"text": "第六十卦,節。",
			"startMs": 0,
			"endMs": 1860
		},
		{
			"speaker": "說書人",
			"text": "節亨。苦節不可貞。",
			"startMs": 1860,
			"endMs": 5880
		},
		{
			"speaker": "說書人",
			"text": "初九不出戶庭,无咎。",
			"startMs": 5880,
			"endMs": 9500
		},
		{
			"speaker": "說書人",
			"text": "九二不出門庭,凶。",
			"startMs": 9500,
			"endMs": 12800
		},
		{
			"speaker": "說書人",
			"text": "六三不節若,則嗟若,无咎。",
			"startMs": 12800,
			"endMs": 17660
		},
		{
			"speaker": "說書人",
			"text": "六四安節,亨。",
			"startMs": 17660,
			"endMs": 20400
		},
		{
			"speaker": "說書人",
			"text": "九五甘節,吉,往有尚。",
			"startMs": 20400,
			"endMs": 24420
		},
		{
			"speaker": "說書人",
			"text": "上六苦節,貞凶,悔亡。",
			"startMs": 24420,
			"endMs": 28640
		}
	]
}
