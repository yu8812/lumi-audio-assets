		{
			"speaker": "說書人",
			"text": "第六十卦,節。",
			"startMs": 0,
			"endMs": 1860
		},
		{
			"speaker": "說書人",
			"text": "節亨。苦節不可貞。",
			"startMs": 1860,
			"endMs": 5560
		},
		{
			"speaker": "說書人",
			"text": "初九不出戶庭,无咎。",
			"startMs": 5560,
			"endMs": 8940
		},
		{
			"speaker": "說書人",
			"text": "九二不出門庭,凶。",
			"startMs": 8940,
			"endMs": 11640
		},
		{
			"speaker": "說書人",
			"text": "六三不節若,則嗟若,无咎。",
			"startMs": 11640,
			"endMs": 15900
		},
		{
			"speaker": "說書人",
			"text": "六四安節,亨。",
			"startMs": 15900,
			"endMs": 18240
		},
		{
			"speaker": "說書人",
			"text": "九五甘節,吉,往有尚。",
			"startMs": 18240,
			"endMs": 22260
		},
		{
			"speaker": "說書人",
			"text": "上六苦節,貞凶,悔亡。",
			"startMs": 22260,
			"endMs": 26280
		}
	]
}
