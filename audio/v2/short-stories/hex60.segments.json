	"segments": [
		{
			"speaker": "說書人",
			"text": "第六十卦,節。",
			"startMs": 0,
			"endMs": 2060
		},
		{
			"speaker": "讀者",
			"text": "節亨。苦節不可貞。",
			"startMs": 2060,
			"endMs": 5440
		},
		{
			"speaker": "讀者",
			"text": "初九不出戶庭,无咎。",
			"startMs": 5440,
			"endMs": 8860
		},
		{
			"speaker": "讀者",
			"text": "九二不出門庭,凶。",
			"startMs": 8860,
			"endMs": 11880
		},
		{
			"speaker": "讀者",
			"text": "六三不節若,則嗟若,无咎。",
			"startMs": 11880,
			"endMs": 16020
		},
		{
			"speaker": "讀者",
			"text": "六四安節,亨。",
			"startMs": 16020,
			"endMs": 18640
		},
		{
			"speaker": "讀者",
			"text": "九五甘節,吉,往有尚。",
			"startMs": 18640,
			"endMs": 21900
		},
		{
			"speaker": "讀者",
			"text": "上六苦節,貞凶,悔亡。",
			"startMs": 21900,
			"endMs": 25520
		}
	]
}
