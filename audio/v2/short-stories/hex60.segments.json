		{
			"speaker": "說書人",
			"text": "第六十卦,節。",
			"startMs": 0,
			"endMs": 1500
		},
		{
			"speaker": "說書人",
			"text": "節亨。苦節不可貞。",
			"startMs": 1500,
			"endMs": 4440
		},
		{
			"speaker": "說書人",
			"text": "初九不出戶庭,无咎。",
			"startMs": 4440,
			"endMs": 7620
		},
		{
			"speaker": "說書人",
			"text": "九二不出門庭,凶。",
			"startMs": 7620,
			"endMs": 10280
		},
		{
			"speaker": "說書人",
			"text": "六三不節若,則嗟若,无咎。",
			"startMs": 10280,
			"endMs": 13620
		},
		{
			"speaker": "說書人",
			"text": "六四安節,亨。",
			"startMs": 13620,
			"endMs": 16080
		},
		{
			"speaker": "說書人",
			"text": "九五甘節,吉,往有尚。",
			"startMs": 16080,
			"endMs": 19100
		},
		{
			"speaker": "說書人",
			"text": "上六苦節,貞凶,悔亡。",
			"startMs": 19100,
			"endMs": 22160
		}
	]
}
