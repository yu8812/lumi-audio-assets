	"segments": [
		{
			"speaker": "說書人",
			"text": "第六十卦,節。",
			"startMs": 0,
			"endMs": 1660
		},
		{
			"speaker": "說書人",
			"text": "節亨。苦節不可貞。",
			"startMs": 1660,
			"endMs": 5960
		},
		{
			"speaker": "說書人",
			"text": "初九不出戶庭,无咎。",
			"startMs": 5960,
			"endMs": 8940
		},
		{
			"speaker": "說書人",
			"text": "九二不出門庭,凶。",
			"startMs": 8940,
			"endMs": 11720
		},
		{
			"speaker": "說書人",
			"text": "六三不節若,則嗟若,无咎。",
			"startMs": 11720,
			"endMs": 15340
		},
		{
			"speaker": "說書人",
			"text": "六四安節,亨。",
			"startMs": 15340,
			"endMs": 17960
		},
		{
			"speaker": "說書人",
			"text": "九五甘節,吉,往有尚。",
			"startMs": 17960,
			"endMs": 21620
		},
		{
			"speaker": "說書人",
			"text": "上六苦節,貞凶,悔亡。",
			"startMs": 21620,
			"endMs": 25200
		}
	]
}
