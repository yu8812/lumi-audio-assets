		{
			"speaker": "說書人",
			"text": "第十五卦,謙。",
			"startMs": 0,
			"endMs": 2020
		},
		{
			"speaker": "讀者",
			"text": "謙亨,君子有終。",
			"startMs": 2020,
			"endMs": 5360
		},
		{
			"speaker": "讀者",
			"text": "初六謙謙君子,用涉大川,吉。",
			"startMs": 5360,
			"endMs": 9640
		},
		{
			"speaker": "讀者",
			"text": "六二鳴謙,貞吉。",
			"startMs": 9640,
			"endMs": 12580
		},
		{
			"speaker": "讀者",
			"text": "九三勞謙,君子有終,吉。",
			"startMs": 12580,
			"endMs": 16120
		},
		{
			"speaker": "讀者",
			"text": "六四无不利,撝謙。",
			"startMs": 16120,
			"endMs": 18980
		},
		{
			"speaker": "讀者",
			"text": "六五不富以其鄰,利用侵伐,无不利。",
			"startMs": 18980,
			"endMs": 24380
		},
		{
			"speaker": "讀者",
			"text": "上六鳴謙,利用行師,征邑國。",
			"startMs": 24380,
			"endMs": 28720
		}
	]
}
