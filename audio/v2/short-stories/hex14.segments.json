	"segments": [
		{
			"speaker": "說書人",
			"text": "第十四卦,大有。",
			"startMs": 0,
			"endMs": 2180
		},
		{
			"speaker": "讀者",
			"text": "大有元亨。",
			"startMs": 2180,
			"endMs": 4280
		},
		{
			"speaker": "讀者",
			"text": "初九无交害,匪咎,艱則无咎。",
			"startMs": 4280,
			"endMs": 8960
		},
		{
			"speaker": "讀者",
			"text": "九二大車以載,有攸往,无咎。",
			"startMs": 8960,
			"endMs": 13320
		},
		{
			"speaker": "讀者",
			"text": "九三公用亨于天子,小人弗克。",
			"startMs": 13320,
			"endMs": 17680
		},
		{
			"speaker": "讀者",
			"text": "九四匪其彭,无咎。",
			"startMs": 17680,
			"endMs": 20620
		},
		{
			"speaker": "讀者",
			"text": "六五厥孚交如,威如,吉。",
			"startMs": 20620,
			"endMs": 24620
		},
		{
			"speaker": "讀者",
			"text": "上九自天祐之,吉无不利。",
			"startMs": 24620,
			"endMs": 28820
		}
	]
}
