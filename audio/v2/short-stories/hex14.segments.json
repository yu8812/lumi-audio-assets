	"segments": [
		{
			"speaker": "說書人",
			"text": "第十四卦,大有。",
			"startMs": 0,
			"endMs": 1660
		},
		{
			"speaker": "說書人",
			"text": "大有元亨。",
			"startMs": 1660,
			"endMs": 3840
		},
		{
			"speaker": "說書人",
			"text": "初九无交害,匪咎,艱則无咎。",
			"startMs": 3840,
			"endMs": 8000
		},
		{
			"speaker": "說書人",
			"text": "九二大車以載,有攸往,无咎。",
			"startMs": 8000,
			"endMs": 11880
		},
		{
			"speaker": "說書人",
			"text": "九三公用亨于天子,小人弗克。",
			"startMs": 11880,
			"endMs": 16360
		},
		{
			"speaker": "說書人",
			"text": "九四匪其彭,无咎。",
			"startMs": 16360,
			"endMs": 19220
		},
		{
			"speaker": "說書人",
			"text": "六五厥孚交如,威如,吉。",
			"startMs": 19220,
			"endMs": 23100
		},
		{
			"speaker": "說書人",
			"text": "上九自天祐之,吉无不利。",
			"startMs": 23100,
			"endMs": 27820
		}
	]
}
