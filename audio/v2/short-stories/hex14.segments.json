	"segments": [
		{
			"speaker": "說書人",
			"text": "第十四卦,大有。",
			"startMs": 0,
			"endMs": 1820
		},
		{
			"speaker": "說書人",
			"text": "大有元亨。",
			"startMs": 1820,
			"endMs": 3920
		},
		{
			"speaker": "說書人",
			"text": "初九无交害,匪咎,艱則无咎。",
			"startMs": 3920,
			"endMs": 8240
		},
		{
			"speaker": "說書人",
			"text": "九二大車以載,有攸往,无咎。",
			"startMs": 8240,
			"endMs": 12200
		},
		{
			"speaker": "說書人",
			"text": "九三公用亨于天子,小人弗克。",
			"startMs": 12200,
			"endMs": 16400
		},
		{
			"speaker": "說書人",
			"text": "九四匪其彭,无咎。",
			"startMs": 16400,
			"endMs": 19020
		},
		{
			"speaker": "說書人",
			"text": "六五厥孚交如,威如,吉。",
			"startMs": 19020,
			"endMs": 23220
		},
		{
			"speaker": "說書人",
			"text": "上九自天祐之,吉无不利。",
			"startMs": 23220,
			"endMs": 26900
		}
	]
}
