	"segments": [
		{
			"speaker": "說書人",
			"text": "第十四卦,大有。",
			"startMs": 0,
			"endMs": 2180
		},
		{
			"speaker": "說書人",
			"text": "大有元亨。",
			"startMs": 2180,
			"endMs": 4280
		},
		{
			"speaker": "說書人",
			"text": "初九无交害,匪咎,艱則无咎。",
			"startMs": 4280,
			"endMs": 8880
		},
		{
			"speaker": "說書人",
			"text": "九二大車以載,有攸往,无咎。",
			"startMs": 8880,
			"endMs": 13480
		},
		{
			"speaker": "說書人",
			"text": "九三公用亨于天子,小人弗克。",
			"startMs": 13480,
			"endMs": 18080
		},
		{
			"speaker": "說書人",
			"text": "九四匪其彭,无咎。",
			"startMs": 18080,
			"endMs": 20900
		},
		{
			"speaker": "說書人",
			"text": "六五厥孚交如,威如,吉。",
			"startMs": 20900,
			"endMs": 25300
		},
		{
			"speaker": "說書人",
			"text": "上九自天祐之,吉无不利。",
			"startMs": 25300,
			"endMs": 29300
		}
	]
}
