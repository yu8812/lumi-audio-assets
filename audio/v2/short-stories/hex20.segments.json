	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十卦,觀。",
			"startMs": 0,
			"endMs": 1820
		},
		{
			"speaker": "讀者",
			"text": "觀盥而不薦,有孚顒若。",
			"startMs": 1820,
			"endMs": 5580
		},
		{
			"speaker": "讀者",
			"text": "初六童觀,小人无咎,君子吝。",
			"startMs": 5580,
			"endMs": 9880
		},
		{
			"speaker": "讀者",
			"text": "六二闚觀,利女貞。",
			"startMs": 9880,
			"endMs": 13020
		},
		{
			"speaker": "讀者",
			"text": "六三觀我生,進退。",
			"startMs": 13020,
			"endMs": 16320
		},
		{
			"speaker": "讀者",
			"text": "六四觀國之光,利用賓于王。",
			"startMs": 16320,
			"endMs": 20680
		},
		{
			"speaker": "讀者",
			"text": "九五觀我生,君子无咎。",
			"startMs": 20680,
			"endMs": 24100
		},
		{
			"speaker": "讀者",
			"text": "上九觀其生,君子无咎。",
			"startMs": 24100,
			"endMs": 27840
		}
	]
}
