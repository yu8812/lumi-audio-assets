	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十卦,觀。",
			"startMs": 0,
			"endMs": 1380
		},
		{
			"speaker": "說書人",
			"text": "觀盥而不薦,有孚顒若。",
			"startMs": 1380,
			"endMs": 4980
		},
		{
			"speaker": "說書人",
			"text": "初六童觀,小人无咎,君子吝。",
			"startMs": 4980,
			"endMs": 8920
		},
		{
			"speaker": "說書人",
			"text": "六二闚觀,利女貞。",
			"startMs": 8920,
			"endMs": 11580
		},
		{
			"speaker": "說書人",
			"text": "六三觀我生,進退。",
			"startMs": 11580,
			"endMs": 14440
		},
		{
			"speaker": "說書人",
			"text": "六四觀國之光,利用賓于王。",
			"startMs": 14440,
			"endMs": 18520
		},
		{
			"speaker": "說書人",
			"text": "九五觀我生,君子无咎。",
			"startMs": 18520,
			"endMs": 21660
		},
		{
			"speaker": "說書人",
			"text": "上九觀其生,君子无咎。",
			"startMs": 21660,
			"endMs": 25120
		}
	]
}
