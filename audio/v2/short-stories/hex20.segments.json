	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十卦,觀。",
			"startMs": 0,
			"endMs": 1860
		},
		{
			"speaker": "說書人",
			"text": "觀盥而不薦,有孚顒若。",
			"startMs": 1860,
			"endMs": 5540
		},
		{
			"speaker": "說書人",
			"text": "初六童觀,小人无咎,君子吝。",
			"startMs": 5540,
			"endMs": 10120
		},
		{
			"speaker": "說書人",
			"text": "六二闚觀,利女貞。",
			"startMs": 10120,
			"endMs": 13260
		},
		{
			"speaker": "說書人",
			"text": "六三觀我生,進退。",
			"startMs": 13260,
			"endMs": 16440
		},
		{
			"speaker": "說書人",
			"text": "六四觀國之光,利用賓于王。",
			"startMs": 16440,
			"endMs": 20640
		},
		{
			"speaker": "說書人",
			"text": "九五觀我生,君子无咎。",
			"startMs": 20640,
			"endMs": 24380
		},
		{
			"speaker": "說書人",
			"text": "上九觀其生,君子无咎。",
			"startMs": 24380,
			"endMs": 28240
		}
	]
}
