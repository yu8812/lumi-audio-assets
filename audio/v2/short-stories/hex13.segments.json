	"slug": "hex13",
	"title": "第十三卦 同人",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex13.mp3",
	"durationMs": 34020,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第十三卦,同人。",
			"startMs": 0,
			"endMs": 2060
		},
		{
			"speaker": "說書人",
			"text": "同人于野,亨。利涉大川,利君子貞。",
			"startMs": 2060,
			"endMs": 7600
		},
		{
			"speaker": "說書人",
			"text": "初九同人于門,无咎。",
			"startMs": 7600,
			"endMs": 11060
		},
		{
			"speaker": "說書人",
			"text": "六二同人于宗,吝。",
			"startMs": 11060,
			"endMs": 14400
		},
		{
			"speaker": "說書人",
			"text": "九三伏戎于莽,升其高陵,三歲不興。",
			"startMs": 14400,
			"endMs": 20420
		},
		{
			"speaker": "說書人",
			"text": "九四乘其墉,弗克攻,吉。",
			"startMs": 20420,
			"endMs": 24440
		},
		{
			"speaker": "說書人",
			"text": "九五同人先號咷而後笑,大師克相遇。",
			"startMs": 24440,
			"endMs": 30440
		},
		{
			"speaker": "說書人",
			"text": "上九同人于郊,无悔。",
			"startMs": 30440,
			"endMs": 34020
		}
	]
}
