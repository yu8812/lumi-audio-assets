	"segments": [
		{
			"speaker": "說書人",
			"text": "第十三卦,同人。",
			"startMs": 0,
			"endMs": 2140
		},
		{
			"speaker": "說書人",
			"text": "同人于野,亨。利涉大川,利君子貞。",
			"startMs": 2140,
			"endMs": 6600
		},
		{
			"speaker": "說書人",
			"text": "初九同人于門,无咎。",
			"startMs": 6600,
			"endMs": 9980
		},
		{
			"speaker": "說書人",
			"text": "六二同人于宗,吝。",
			"startMs": 9980,
			"endMs": 12640
		},
		{
			"speaker": "說書人",
			"text": "九三伏戎于莽,升其高陵,三歲不興。",
			"startMs": 12640,
			"endMs": 18060
		},
		{
			"speaker": "說書人",
			"text": "九四乘其墉,弗克攻,吉。",
			"startMs": 18060,
			"endMs": 22000
		},
		{
			"speaker": "說書人",
			"text": "九五同人先號咷而後笑,大師克相遇。",
			"startMs": 22000,
			"endMs": 27360
		},
		{
			"speaker": "說書人",
			"text": "上九同人于郊,无悔。",
			"startMs": 27360,
			"endMs": 31140
		}
	]
}
