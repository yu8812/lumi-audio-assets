	"segments": [
		{
			"speaker": "說書人",
			"text": "第十三卦,同人。",
			"startMs": 0,
			"endMs": 1900
		},
		{
			"speaker": "說書人",
			"text": "同人于野,亨。利涉大川,利君子貞。",
			"startMs": 1900,
			"endMs": 7040
		},
		{
			"speaker": "說書人",
			"text": "初九同人于門,无咎。",
			"startMs": 7040,
			"endMs": 10100
		},
		{
			"speaker": "說書人",
			"text": "六二同人于宗,吝。",
			"startMs": 10100,
			"endMs": 12760
		},
		{
			"speaker": "說書人",
			"text": "九三伏戎于莽,升其高陵,三歲不興。",
			"startMs": 12760,
			"endMs": 17820
		},
		{
			"speaker": "說書人",
			"text": "九四乘其墉,弗克攻,吉。",
			"startMs": 17820,
			"endMs": 21280
		},
		{
			"speaker": "說書人",
			"text": "九五同人先號咷而後笑,大師克相遇。",
			"startMs": 21280,
			"endMs": 25920
		},
		{
			"speaker": "說書人",
			"text": "上九同人于郊,无悔。",
			"startMs": 25920,
			"endMs": 28780
		}
	]
}
