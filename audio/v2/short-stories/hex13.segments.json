	"slug": "hex13",
	"title": "第十三卦 同人",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex13.mp3",
	"durationMs": 27820,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第十三卦,同人。",
			"startMs": 0,
			"endMs": 1660
		},
		{
			"speaker": "說書人",
			"text": "同人于野,亨。利涉大川,利君子貞。",
			"startMs": 1660,
			"endMs": 5680
		},
		{
			"speaker": "說書人",
			"text": "初九同人于門,无咎。",
			"startMs": 5680,
			"endMs": 8500
		},
		{
			"speaker": "說書人",
			"text": "六二同人于宗,吝。",
			"startMs": 8500,
			"endMs": 11280
		},
		{
			"speaker": "說書人",
			"text": "九三伏戎于莽,升其高陵,三歲不興。",
			"startMs": 11280,
			"endMs": 16340
		},
		{
			"speaker": "說書人",
			"text": "九四乘其墉,弗克攻,吉。",
			"startMs": 16340,
			"endMs": 19800
		},
		{
			"speaker": "說書人",
			"text": "九五同人先號咷而後笑,大師克相遇。",
			"startMs": 19800,
			"endMs": 24640
		},
		{
			"speaker": "說書人",
			"text": "上九同人于郊,无悔。",
			"startMs": 24640,
			"endMs": 27820
		}
	]
}
