	"slug": "hex13",
	"title": "第十三卦 同人",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex13.mp3",
	"durationMs": 31420,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第十三卦,同人。",
			"startMs": 0,
			"endMs": 2180
		},
		{
			"speaker": "讀者",
			"text": "同人于野,亨。利涉大川,利君子貞。",
			"startMs": 2180,
			"endMs": 7040
		},
		{
			"speaker": "讀者",
			"text": "初九同人于門,无咎。",
			"startMs": 7040,
			"endMs": 10220
		},
		{
			"speaker": "讀者",
			"text": "六二同人于宗,吝。",
			"startMs": 10220,
			"endMs": 13360
		},
		{
			"speaker": "讀者",
			"text": "九三伏戎于莽,升其高陵,三歲不興。",
			"startMs": 13360,
			"endMs": 18980
		},
		{
			"speaker": "讀者",
			"text": "九四乘其墉,弗克攻,吉。",
			"startMs": 18980,
			"endMs": 22680
		},
		{
			"speaker": "讀者",
			"text": "九五同人先號咷而後笑,大師克相遇。",
			"startMs": 22680,
			"endMs": 28320
		},
		{
			"speaker": "讀者",
			"text": "上九同人于郊,无悔。",
			"startMs": 28320,
			"endMs": 31420
		}
	]
}
