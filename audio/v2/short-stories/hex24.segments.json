	"title": "第二十四卦 復",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex24.mp3",
	"durationMs": 37840,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十四卦,復。",
			"startMs": 0,
			"endMs": 2180
		},
		{
			"speaker": "說書人",
			"text": "復亨。出入无疾,朋來无咎。反復其道,七日來復。利有攸往。",
			"startMs": 2180,
			"endMs": 10280
		},
		{
			"speaker": "說書人",
			"text": "初九不遠復,无祗悔,元吉。",
			"startMs": 10280,
			"endMs": 14980
		},
		{
			"speaker": "說書人",
			"text": "六二休復,吉。",
			"startMs": 14980,
			"endMs": 17360
		},
		{
			"speaker": "說書人",
			"text": "六三頻復,厲,无咎。",
			"startMs": 17360,
			"endMs": 20900
		},
		{
			"speaker": "說書人",
			"text": "六四中行獨復。",
			"startMs": 20900,
			"endMs": 23800
		},
		{
			"speaker": "說書人",
			"text": "六五敦復,无悔。",
			"startMs": 23800,
			"endMs": 26420
		},
		{
			"speaker": "說書人",
			"text": "上六迷復,凶,有災眚。用行師,終有大敗,以其國君凶,至于十年不克征。",
			"startMs": 26420,
			"endMs": 37840
		}
	]
}
