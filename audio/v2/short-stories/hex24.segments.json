{
	"slug": "hex24",
	"title": "第二十四卦 復",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex24.mp3",
	"durationMs": 36880,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十四卦,復。",
			"startMs": 0,
			"endMs": 1940
		},
		{
			"speaker": "讀者",
			"text": "復亨。出入无疾,朋來无咎。反復其道,七日來復。利有攸往。",
			"startMs": 1940,
			"endMs": 10840
		},
		{
			"speaker": "讀者",
			"text": "初九不遠復,无祗悔,元吉。",
			"startMs": 10840,
			"endMs": 15100
		},
		{
			"speaker": "讀者",
			"text": "六二休復,吉。",
			"startMs": 15100,
			"endMs": 17560
		},
		{
			"speaker": "讀者",
			"text": "六三頻復,厲,无咎。",
			"startMs": 17560,
			"endMs": 21180
		},
		{
			"speaker": "讀者",
			"text": "六四中行獨復。",
			"startMs": 21180,
			"endMs": 24120
		},
		{
			"speaker": "讀者",
			"text": "六五敦復,无悔。",
			"startMs": 24120,
			"endMs": 26740
		},
		{
			"speaker": "讀者",
			"text": "上六迷復,凶,有災眚。用行師,終有大敗,以其國君凶,至于十年不克征。",
			"startMs": 26740,
			"endMs": 36880
		}
	]
}
