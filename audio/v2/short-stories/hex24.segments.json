	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十四卦,復。",
			"startMs": 0,
			"endMs": 1500
		},
		{
			"speaker": "說書人",
			"text": "復亨。出入无疾,朋來无咎。反復其道,七日來復。利有攸往。",
			"startMs": 1500,
			"endMs": 10200
		},
		{
			"speaker": "說書人",
			"text": "初九不遠復,无祗悔,元吉。",
			"startMs": 10200,
			"endMs": 13780
		},
		{
			"speaker": "說書人",
			"text": "六二休復,吉。",
			"startMs": 13780,
			"endMs": 16160
		},
		{
			"speaker": "說書人",
			"text": "六三頻復,厲,无咎。",
			"startMs": 16160,
			"endMs": 18940
		},
		{
			"speaker": "說書人",
			"text": "六四中行獨復。",
			"startMs": 18940,
			"endMs": 21520
		},
		{
			"speaker": "說書人",
			"text": "六五敦復,无悔。",
			"startMs": 21520,
			"endMs": 24100
		},
		{
			"speaker": "說書人",
			"text": "上六迷復,凶,有災眚。用行師,終有大敗,以其國君凶,至于十年不克征。",
			"startMs": 24100,
			"endMs": 33120
		}
	]
}
