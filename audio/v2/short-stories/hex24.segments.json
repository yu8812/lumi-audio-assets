	"title": "第二十四卦 復",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex24.mp3",
	"durationMs": 37240,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十四卦,復。",
			"startMs": 0,
			"endMs": 2060
		},
		{
			"speaker": "說書人",
			"text": "復亨。出入无疾,朋來无咎。反復其道,七日來復。利有攸往。",
			"startMs": 2060,
			"endMs": 10920
		},
		{
			"speaker": "說書人",
			"text": "初九不遠復,无祗悔,元吉。",
			"startMs": 10920,
			"endMs": 15460
		},
		{
			"speaker": "說書人",
			"text": "六二休復,吉。",
			"startMs": 15460,
			"endMs": 18160
		},
		{
			"speaker": "說書人",
			"text": "六三頻復,厲,无咎。",
			"startMs": 18160,
			"endMs": 21580
		},
		{
			"speaker": "說書人",
			"text": "六四中行獨復。",
			"startMs": 21580,
			"endMs": 24120
		},
		{
			"speaker": "說書人",
			"text": "六五敦復,无悔。",
			"startMs": 24120,
			"endMs": 27180
		},
		{
			"speaker": "說書人",
			"text": "上六迷復,凶,有災眚。用行師,終有大敗,以其國君凶,至于十年不克征。",
			"startMs": 27180,
			"endMs": 37240
		}
	]
}
