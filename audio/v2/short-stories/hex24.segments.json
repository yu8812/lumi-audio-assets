	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十四卦,復。",
			"startMs": 0,
			"endMs": 1860
		},
		{
			"speaker": "說書人",
			"text": "復亨。出入无疾,朋來无咎。反復其道,七日來復。利有攸往。",
			"startMs": 1860,
			"endMs": 9760
		},
		{
			"speaker": "說書人",
			"text": "初九不遠復,无祗悔,元吉。",
			"startMs": 9760,
			"endMs": 13380
		},
		{
			"speaker": "說書人",
			"text": "六二休復,吉。",
			"startMs": 13380,
			"endMs": 15880
		},
		{
			"speaker": "說書人",
			"text": "六三頻復,厲,无咎。",
			"startMs": 15880,
			"endMs": 18820
		},
		{
			"speaker": "說書人",
			"text": "六四中行獨復。",
			"startMs": 18820,
			"endMs": 21480
		},
		{
			"speaker": "說書人",
			"text": "六五敦復,无悔。",
			"startMs": 21480,
			"endMs": 23980
		},
		{
			"speaker": "說書人",
			"text": "上六迷復,凶,有災眚。用行師,終有大敗,以其國君凶,至于十年不克征。",
			"startMs": 23980,
			"endMs": 32920
		}
	]
}
