	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十八卦,大過。",
			"startMs": 0,
			"endMs": 2300
		},
		{
			"speaker": "說書人",
			"text": "大過棟橈。利有攸往,亨。",
			"startMs": 2300,
			"endMs": 6560
		},
		{
			"speaker": "說書人",
			"text": "初六藉用白茅,无咎。",
			"startMs": 6560,
			"endMs": 10180
		},
		{
			"speaker": "說書人",
			"text": "九二枯楊生稊,老夫得其女妻,无不利。",
			"startMs": 10180,
			"endMs": 16140
		},
		{
			"speaker": "說書人",
			"text": "九三棟橈,凶。",
			"startMs": 16140,
			"endMs": 18600
		},
		{
			"speaker": "說書人",
			"text": "九四棟隆,吉。有它吝。",
			"startMs": 18600,
			"endMs": 21700
		},
		{
			"speaker": "說書人",
			"text": "九五枯楊生華,老婦得其士夫,无咎无譽。",
			"startMs": 21700,
			"endMs": 28040
		},
		{
			"speaker": "說書人",
			"text": "上六過涉滅頂,凶,无咎。",
			"startMs": 28040,
			"endMs": 32040
		}
	]
}
