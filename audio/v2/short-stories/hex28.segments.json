{
	"slug": "hex28",
	"title": "第二十八卦 大過",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex28.mp3",
	"durationMs": 28000,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十八卦,大過。",
			"startMs": 0,
			"endMs": 1820
		},
		{
			"speaker": "說書人",
			"text": "大過棟橈。利有攸往,亨。",
			"startMs": 1820,
			"endMs": 5280
		},
		{
			"speaker": "說書人",
			"text": "初六藉用白茅,无咎。",
			"startMs": 5280,
			"endMs": 8180
		},
		{
			"speaker": "說書人",
			"text": "九二枯楊生稊,老夫得其女妻,无不利。",
			"startMs": 8180,
			"endMs": 13300
		},
		{
			"speaker": "說書人",
			"text": "九三棟橈,凶。",
			"startMs": 13300,
			"endMs": 15680
		},
		{
			"speaker": "說書人",
			"text": "九四棟隆,吉。有它吝。",
			"startMs": 15680,
			"endMs": 18940
		},
		{
			"speaker": "說書人",
			"text": "九五枯楊生華,老婦得其士夫,无咎无譽。",
			"startMs": 18940,
			"endMs": 24320
		},
		{
			"speaker": "說書人",
			"text": "上六過涉滅頂,凶,无咎。",
			"startMs": 24320,
			"endMs": 28000
		}
	]
}
