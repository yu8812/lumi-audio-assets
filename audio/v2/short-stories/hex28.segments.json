	"segments": [
		{
			"speaker": "說書人",
			"text": "第二十八卦,大過。",
			"startMs": 0,
			"endMs": 1740
		},
		{
			"speaker": "說書人",
			"text": "大過棟橈。利有攸往,亨。",
			"startMs": 1740,
			"endMs": 4880
		},
		{
			"speaker": "說書人",
			"text": "初六藉用白茅,无咎。",
			"startMs": 4880,
			"endMs": 7700
		},
		{
			"speaker": "說書人",
			"text": "九二枯楊生稊,老夫得其女妻,无不利。",
			"startMs": 7700,
			"endMs": 12700
		},
		{
			"speaker": "說書人",
			"text": "九三棟橈,凶。",
			"startMs": 12700,
			"endMs": 15160
		},
		{
			"speaker": "說書人",
			"text": "九四棟隆,吉。有它吝。",
			"startMs": 15160,
			"endMs": 18060
		},
		{
			"speaker": "說書人",
			"text": "九五枯楊生華,老婦得其士夫,无咎无譽。",
			"startMs": 18060,
			"endMs": 23800
		},
		{
			"speaker": "說書人",
			"text": "上六過涉滅頂,凶,无咎。",
			"startMs": 23800,
			"endMs": 27360
		}
	]
}
