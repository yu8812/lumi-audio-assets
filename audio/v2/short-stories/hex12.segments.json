	"segments": [
		{
			"speaker": "說書人",
			"text": "第十二卦,否。",
			"startMs": 0,
			"endMs": 1540
		},
		{
			"speaker": "說書人",
			"text": "否之匪人,不利君子貞,大往小來。",
			"startMs": 1540,
			"endMs": 6120
		},
		{
			"speaker": "說書人",
			"text": "初六拔茅茹,以其彙,貞吉亨。",
			"startMs": 6120,
			"endMs": 10900
		},
		{
			"speaker": "說書人",
			"text": "六二包承,小人吉,大人否亨。",
			"startMs": 10900,
			"endMs": 16180
		},
		{
			"speaker": "說書人",
			"text": "六三包羞。",
			"startMs": 16180,
			"endMs": 18440
		},
		{
			"speaker": "說書人",
			"text": "九四有命无咎,疇離祉。",
			"startMs": 18440,
			"endMs": 22580
		},
		{
			"speaker": "說書人",
			"text": "九五休否,大人吉。其亡其亡,繫于苞桑。",
			"startMs": 22580,
			"endMs": 29040
		},
		{
			"speaker": "說書人",
			"text": "上九傾否,先否後喜。",
			"startMs": 29040,
			"endMs": 32740
		}
	]
}
