	"segments": [
		{
			"speaker": "說書人",
			"text": "第十二卦,否。",
			"startMs": 0,
			"endMs": 1780
		},
		{
			"speaker": "說書人",
			"text": "否之匪人,不利君子貞,大往小來。",
			"startMs": 1780,
			"endMs": 6280
		},
		{
			"speaker": "說書人",
			"text": "初六拔茅茹,以其彙,貞吉亨。",
			"startMs": 6280,
			"endMs": 10820
		},
		{
			"speaker": "說書人",
			"text": "六二包承,小人吉,大人否亨。",
			"startMs": 10820,
			"endMs": 15580
		},
		{
			"speaker": "說書人",
			"text": "六三包羞。",
			"startMs": 15580,
			"endMs": 17600
		},
		{
			"speaker": "說書人",
			"text": "九四有命无咎,疇離祉。",
			"startMs": 17600,
			"endMs": 21340
		},
		{
			"speaker": "說書人",
			"text": "九五休否,大人吉。其亡其亡,繫于苞桑。",
			"startMs": 21340,
			"endMs": 27480
		},
		{
			"speaker": "說書人",
			"text": "上九傾否,先否後喜。",
			"startMs": 27480,
			"endMs": 31300
		}
	]
}
