	"segments": [
		{
			"speaker": "說書人",
			"text": "第十二卦,否。",
			"startMs": 0,
			"endMs": 1420
		},
		{
			"speaker": "說書人",
			"text": "否之匪人,不利君子貞,大往小來。",
			"startMs": 1420,
			"endMs": 5800
		},
		{
			"speaker": "說書人",
			"text": "初六拔茅茹,以其彙,貞吉亨。",
			"startMs": 5800,
			"endMs": 9980
		},
		{
			"speaker": "說書人",
			"text": "六二包承,小人吉,大人否亨。",
			"startMs": 9980,
			"endMs": 14220
		},
		{
			"speaker": "說書人",
			"text": "六三包羞。",
			"startMs": 14220,
			"endMs": 16480
		},
		{
			"speaker": "說書人",
			"text": "九四有命无咎,疇離祉。",
			"startMs": 16480,
			"endMs": 19860
		},
		{
			"speaker": "說書人",
			"text": "九五休否,大人吉。其亡其亡,繫于苞桑。",
			"startMs": 19860,
			"endMs": 25240
		},
		{
			"speaker": "說書人",
			"text": "上九傾否,先否後喜。",
			"startMs": 25240,
			"endMs": 28260
		}
	]
}
