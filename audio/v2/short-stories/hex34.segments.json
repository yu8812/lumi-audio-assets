	"segments": [
		{
			"speaker": "說書人",
			"text": "第三十四卦,大壯。",
			"startMs": 0,
			"endMs": 2300
		},
		{
			"speaker": "說書人",
			"text": "大壯利貞。",
			"startMs": 2300,
			"endMs": 4280
		},
		{
			"speaker": "說書人",
			"text": "初九壯于趾,征凶,有孚。",
			"startMs": 4280,
			"endMs": 7620
		},
		{
			"speaker": "說書人",
			"text": "九二貞吉。",
			"startMs": 7620,
			"endMs": 9680
		},
		{
			"speaker": "說書人",
			"text": "九三小人用壯,君子用罔,貞厲。羝羊觸藩,羸其角。",
			"startMs": 9680,
			"endMs": 17460
		},
		{
			"speaker": "說書人",
			"text": "九四貞吉,悔亡。藩決不羸,壯于大輿之輹。",
			"startMs": 17460,
			"endMs": 23640
		},
		{
			"speaker": "說書人",
			"text": "六五喪羊于易,无悔。",
			"startMs": 23640,
			"endMs": 26820
		},
		{
			"speaker": "說書人",
			"text": "上六羝羊觸藩,不能退,不能遂,无攸利,艱則吉。",
			"startMs": 26820,
			"endMs": 34000
		}
	]
}
