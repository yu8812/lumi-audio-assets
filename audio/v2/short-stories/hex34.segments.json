	"segments": [
		{
			"speaker": "說書人",
			"text": "第三十四卦,大壯。",
			"startMs": 0,
			"endMs": 2500
		},
		{
			"speaker": "說書人",
			"text": "大壯利貞。",
			"startMs": 2500,
			"endMs": 4640
		},
		{
			"speaker": "說書人",
			"text": "初九壯于趾,征凶,有孚。",
			"startMs": 4640,
			"endMs": 9220
		},
		{
			"speaker": "說書人",
			"text": "九二貞吉。",
			"startMs": 9220,
			"endMs": 11400
		},
		{
			"speaker": "說書人",
			"text": "九三小人用壯,君子用罔,貞厲。羝羊觸藩,羸其角。",
			"startMs": 11400,
			"endMs": 19460
		},
		{
			"speaker": "說書人",
			"text": "九四貞吉,悔亡。藩決不羸,壯于大輿之輹。",
			"startMs": 19460,
			"endMs": 26360
		},
		{
			"speaker": "說書人",
			"text": "六五喪羊于易,无悔。",
			"startMs": 26360,
			"endMs": 29940
		},
		{
			"speaker": "說書人",
			"text": "上六羝羊觸藩,不能退,不能遂,无攸利,艱則吉。",
			"startMs": 29940,
			"endMs": 37800
		}
	]
}
