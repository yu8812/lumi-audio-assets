	"segments": [
		{
			"speaker": "說書人",
			"text": "第三十四卦,大壯。",
			"startMs": 0,
			"endMs": 2540
		},
		{
			"speaker": "讀者",
			"text": "大壯利貞。",
			"startMs": 2540,
			"endMs": 4560
		},
		{
			"speaker": "讀者",
			"text": "初九壯于趾,征凶,有孚。",
			"startMs": 4560,
			"endMs": 8260
		},
		{
			"speaker": "讀者",
			"text": "九二貞吉。",
			"startMs": 8260,
			"endMs": 10520
		},
		{
			"speaker": "讀者",
			"text": "九三小人用壯,君子用罔,貞厲。羝羊觸藩,羸其角。",
			"startMs": 10520,
			"endMs": 17020
		},
		{
			"speaker": "讀者",
			"text": "九四貞吉,悔亡。藩決不羸,壯于大輿之輹。",
			"startMs": 17020,
			"endMs": 23240
		},
		{
			"speaker": "讀者",
			"text": "六五喪羊于易,无悔。",
			"startMs": 23240,
			"endMs": 26300
		},
		{
			"speaker": "讀者",
			"text": "上六羝羊觸藩,不能退,不能遂,无攸利,艱則吉。",
			"startMs": 26300,
			"endMs": 33600
		}
	]
}
