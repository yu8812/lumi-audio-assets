	"segments": [
		{
			"speaker": "說書人",
			"text": "第三十四卦,大壯。",
			"startMs": 0,
			"endMs": 2020
		},
		{
			"speaker": "說書人",
			"text": "大壯利貞。",
			"startMs": 2020,
			"endMs": 4240
		},
		{
			"speaker": "說書人",
			"text": "初九壯于趾,征凶,有孚。",
			"startMs": 4240,
			"endMs": 7220
		},
		{
			"speaker": "說書人",
			"text": "九二貞吉。",
			"startMs": 7220,
			"endMs": 9400
		},
		{
			"speaker": "說書人",
			"text": "九三小人用壯,君子用罔,貞厲。羝羊觸藩,羸其角。",
			"startMs": 9400,
			"endMs": 16500
		},
		{
			"speaker": "說書人",
			"text": "九四貞吉,悔亡。藩決不羸,壯于大輿之輹。",
			"startMs": 16500,
			"endMs": 21840
		},
		{
			"speaker": "說書人",
			"text": "六五喪羊于易,无悔。",
			"startMs": 21840,
			"endMs": 24580
		},
		{
			"speaker": "說書人",
			"text": "上六羝羊觸藩,不能退,不能遂,无攸利,艱則吉。",
			"startMs": 24580,
			"endMs": 30800
		}
	]
}
