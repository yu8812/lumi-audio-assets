	"segments": [
		{
			"speaker": "說書人",
			"text": "第三十四卦,大壯。",
			"startMs": 0,
			"endMs": 1780
		},
		{
			"speaker": "說書人",
			"text": "大壯利貞。",
			"startMs": 1780,
			"endMs": 3920
		},
		{
			"speaker": "說書人",
			"text": "初九壯于趾,征凶,有孚。",
			"startMs": 3920,
			"endMs": 7260
		},
		{
			"speaker": "說書人",
			"text": "九二貞吉。",
			"startMs": 7260,
			"endMs": 9720
		},
		{
			"speaker": "說書人",
			"text": "九三小人用壯,君子用罔,貞厲。羝羊觸藩,羸其角。",
			"startMs": 9720,
			"endMs": 16540
		},
		{
			"speaker": "說書人",
			"text": "九四貞吉,悔亡。藩決不羸,壯于大輿之輹。",
			"startMs": 16540,
			"endMs": 22080
		},
		{
			"speaker": "說書人",
			"text": "六五喪羊于易,无悔。",
			"startMs": 22080,
			"endMs": 25020
		},
		{
			"speaker": "說書人",
			"text": "上六羝羊觸藩,不能退,不能遂,无攸利,艱則吉。",
			"startMs": 25020,
			"endMs": 31320
		}
	]
}
