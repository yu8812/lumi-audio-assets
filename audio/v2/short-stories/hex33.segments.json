		{
			"speaker": "說書人",
			"text": "第三十三卦,遯。",
			"startMs": 0,
			"endMs": 1780
		},
		{
			"speaker": "說書人",
			"text": "遯亨,小利貞。",
			"startMs": 1780,
			"endMs": 4240
		},
		{
			"speaker": "說書人",
			"text": "初六遯尾,厲,勿用有攸往。",
			"startMs": 4240,
			"endMs": 8280
		},
		{
			"speaker": "說書人",
			"text": "六二執之用黃牛之革,莫之勝說。",
			"startMs": 8280,
			"endMs": 12640
		},
		{
			"speaker": "說書人",
			"text": "九三係遯,有疾厲,畜臣妾吉。",
			"startMs": 12640,
			"endMs": 17000
		},
		{
			"speaker": "說書人",
			"text": "九四好遯,君子吉,小人否。",
			"startMs": 17000,
			"endMs": 20740
		},
		{
			"speaker": "說書人",
			"text": "九五嘉遯,貞吉。",
			"startMs": 20740,
			"endMs": 23320
		},
		{
			"speaker": "說書人",
			"text": "上九肥遯,无不利。",
			"startMs": 23320,
			"endMs": 26260
		}
	]
}
