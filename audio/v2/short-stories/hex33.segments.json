	"segments": [
		{
			"speaker": "說書人",
			"text": "第三十三卦,遯。",
			"startMs": 0,
			"endMs": 2100
		},
		{
			"speaker": "說書人",
			"text": "遯亨,小利貞。",
			"startMs": 2100,
			"endMs": 4920
		},
		{
			"speaker": "說書人",
			"text": "初六遯尾,厲,勿用有攸往。",
			"startMs": 4920,
			"endMs": 8680
		},
		{
			"speaker": "說書人",
			"text": "六二執之用黃牛之革,莫之勝說。",
			"startMs": 8680,
			"endMs": 13240
		},
		{
			"speaker": "說書人",
			"text": "九三係遯,有疾厲,畜臣妾吉。",
			"startMs": 13240,
			"endMs": 18040
		},
		{
			"speaker": "說書人",
			"text": "九四好遯,君子吉,小人否。",
			"startMs": 18040,
			"endMs": 22620
		},
		{
			"speaker": "說書人",
			"text": "九五嘉遯,貞吉。",
			"startMs": 22620,
			"endMs": 25720
		},
		{
			"speaker": "說書人",
			"text": "上九肥遯,无不利。",
			"startMs": 25720,
			"endMs": 28900
		}
	]
}
