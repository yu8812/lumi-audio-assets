		{
			"speaker": "說書人",
			"text": "第三十三卦,遯。",
			"startMs": 0,
			"endMs": 1780
		},
		{
			"speaker": "說書人",
			"text": "遯亨,小利貞。",
			"startMs": 1780,
			"endMs": 4680
		},
		{
			"speaker": "說書人",
			"text": "初六遯尾,厲,勿用有攸往。",
			"startMs": 4680,
			"endMs": 9280
		},
		{
			"speaker": "說書人",
			"text": "六二執之用黃牛之革,莫之勝說。",
			"startMs": 9280,
			"endMs": 14640
		},
		{
			"speaker": "說書人",
			"text": "九三係遯,有疾厲,畜臣妾吉。",
			"startMs": 14640,
			"endMs": 19760
		},
		{
			"speaker": "說書人",
			"text": "九四好遯,君子吉,小人否。",
			"startMs": 19760,
			"endMs": 24220
		},
		{
			"speaker": "說書人",
			"text": "九五嘉遯,貞吉。",
			"startMs": 24220,
			"endMs": 26480
		},
		{
			"speaker": "說書人",
			"text": "上九肥遯,无不利。",
			"startMs": 26480,
			"endMs": 29820
		}
	]
}
