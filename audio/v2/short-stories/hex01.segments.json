	"segments": [
		{
			"speaker": "說書人",
			"text": "第一卦,乾。",
			"startMs": 0,
			"endMs": 1780
		},
		{
			"speaker": "說書人",
			"text": "乾元、亨、利、貞。",
			"startMs": 1780,
			"endMs": 5640
		},
		{
			"speaker": "說書人",
			"text": "初九潛龍勿用。",
			"startMs": 5640,
			"endMs": 8260
		},
		{
			"speaker": "說書人",
			"text": "九二見龍在田,利見大人。",
			"startMs": 8260,
			"endMs": 12380
		},
		{
			"speaker": "說書人",
			"text": "九三君子終日乾乾,夕惕若厲,无咎。",
			"startMs": 12380,
			"endMs": 17820
		},
		{
			"speaker": "說書人",
			"text": "九四或躍在淵,无咎。",
			"startMs": 17820,
			"endMs": 20760
		},
		{
			"speaker": "說書人",
			"text": "九五飛龍在天,利見大人。",
			"startMs": 20760,
			"endMs": 24760
		},
		{
			"speaker": "說書人",
			"text": "上九亢龍有悔。",
			"startMs": 24760,
			"endMs": 27540
		},
		{
			"speaker": "說書人",
			"text": "用九見群龍无首,吉。",
			"startMs": 27540,
			"endMs": 31280
		}
	]
}
