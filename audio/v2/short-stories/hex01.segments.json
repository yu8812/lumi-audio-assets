	"segments": [
		{
			"speaker": "說書人",
			"text": "第一卦,乾。",
			"startMs": 0,
			"endMs": 1140
		},
		{
			"speaker": "說書人",
			"text": "乾元、亨、利、貞。",
			"startMs": 1140,
			"endMs": 4000
		},
		{
			"speaker": "說書人",
			"text": "初九潛龍勿用。",
			"startMs": 4000,
			"endMs": 6500
		},
		{
			"speaker": "說書人",
			"text": "九二見龍在田,利見大人。",
			"startMs": 6500,
			"endMs": 10060
		},
		{
			"speaker": "說書人",
			"text": "九三君子終日乾乾,夕惕若厲,无咎。",
			"startMs": 10060,
			"endMs": 14660
		},
		{
			"speaker": "說書人",
			"text": "九四或躍在淵,无咎。",
			"startMs": 14660,
			"endMs": 17480
		},
		{
			"speaker": "說書人",
			"text": "九五飛龍在天,利見大人。",
			"startMs": 17480,
			"endMs": 21160
		},
		{
			"speaker": "說書人",
			"text": "上九亢龍有悔。",
			"startMs": 21160,
			"endMs": 23700
		},
		{
			"speaker": "說書人",
			"text": "用九見群龍无首,吉。",
			"startMs": 23700,
			"endMs": 26640
		}
	]
}
