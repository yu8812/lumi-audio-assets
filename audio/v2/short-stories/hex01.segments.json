	"segments": [
		{
			"speaker": "說書人",
			"text": "第一卦,乾。",
			"startMs": 0,
			"endMs": 1580
		},
		{
			"speaker": "說書人",
			"text": "乾元、亨、利、貞。",
			"startMs": 1580,
			"endMs": 5240
		},
		{
			"speaker": "說書人",
			"text": "初九潛龍勿用。",
			"startMs": 5240,
			"endMs": 8020
		},
		{
			"speaker": "說書人",
			"text": "九二見龍在田,利見大人。",
			"startMs": 8020,
			"endMs": 13140
		},
		{
			"speaker": "說書人",
			"text": "九三君子終日乾乾,夕惕若厲,无咎。",
			"startMs": 13140,
			"endMs": 19180
		},
		{
			"speaker": "說書人",
			"text": "九四或躍在淵,无咎。",
			"startMs": 19180,
			"endMs": 22600
		},
		{
			"speaker": "說書人",
			"text": "九五飛龍在天,利見大人。",
			"startMs": 22600,
			"endMs": 27000
		},
		{
			"speaker": "說書人",
			"text": "上九亢龍有悔。",
			"startMs": 27000,
			"endMs": 29780
		},
		{
			"speaker": "說書人",
			"text": "用九見群龍无首,吉。",
			"startMs": 29780,
			"endMs": 33320
		}
	]
}
