	"segments": [
		{
			"speaker": "說書人",
			"text": "第一卦,乾。",
			"startMs": 0,
			"endMs": 1740
		},
		{
			"speaker": "讀者",
			"text": "乾元、亨、利、貞。",
			"startMs": 1740,
			"endMs": 4880
		},
		{
			"speaker": "讀者",
			"text": "初九潛龍勿用。",
			"startMs": 4880,
			"endMs": 7580
		},
		{
			"speaker": "讀者",
			"text": "九二見龍在田,利見大人。",
			"startMs": 7580,
			"endMs": 11740
		},
		{
			"speaker": "讀者",
			"text": "九三君子終日乾乾,夕惕若厲,无咎。",
			"startMs": 11740,
			"endMs": 17420
		},
		{
			"speaker": "讀者",
			"text": "九四或躍在淵,无咎。",
			"startMs": 17420,
			"endMs": 20800
		},
		{
			"speaker": "讀者",
			"text": "九五飛龍在天,利見大人。",
			"startMs": 20800,
			"endMs": 24920
		},
		{
			"speaker": "讀者",
			"text": "上九亢龍有悔。",
			"startMs": 24920,
			"endMs": 27460
		},
		{
			"speaker": "讀者",
			"text": "用九見群龍无首,吉。",
			"startMs": 27460,
			"endMs": 30720
		}
	]
}
