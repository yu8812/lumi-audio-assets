	"segments": [
		{
			"speaker": "說書人",
			"text": "第一卦,乾。",
			"startMs": 0,
			"endMs": 1300
		},
		{
			"speaker": "說書人",
			"text": "乾元、亨、利、貞。",
			"startMs": 1300,
			"endMs": 3880
		},
		{
			"speaker": "說書人",
			"text": "初九潛龍勿用。",
			"startMs": 3880,
			"endMs": 6340
		},
		{
			"speaker": "說書人",
			"text": "九二見龍在田,利見大人。",
			"startMs": 6340,
			"endMs": 10140
		},
		{
			"speaker": "說書人",
			"text": "九三君子終日乾乾,夕惕若厲,无咎。",
			"startMs": 10140,
			"endMs": 15340
		},
		{
			"speaker": "說書人",
			"text": "九四或躍在淵,无咎。",
			"startMs": 15340,
			"endMs": 18480
		},
		{
			"speaker": "說書人",
			"text": "九五飛龍在天,利見大人。",
			"startMs": 18480,
			"endMs": 22280
		},
		{
			"speaker": "說書人",
			"text": "上九亢龍有悔。",
			"startMs": 22280,
			"endMs": 24980
		},
		{
			"speaker": "說書人",
			"text": "用九見群龍无首,吉。",
			"startMs": 24980,
			"endMs": 27920
		}
	]
}
