	"segments": [
		{
			"speaker": "說書人",
			"text": "第一卦,乾。",
			"startMs": 0,
			"endMs": 1620
		},
		{
			"speaker": "說書人",
			"text": "乾元、亨、利、貞。",
			"startMs": 1620,
			"endMs": 4360
		},
		{
			"speaker": "說書人",
			"text": "初九潛龍勿用。",
			"startMs": 4360,
			"endMs": 7060
		},
		{
			"speaker": "說書人",
			"text": "九二見龍在田,利見大人。",
			"startMs": 7060,
			"endMs": 11500
		},
		{
			"speaker": "說書人",
			"text": "九三君子終日乾乾,夕惕若厲,无咎。",
			"startMs": 11500,
			"endMs": 17460
		},
		{
			"speaker": "說書人",
			"text": "九四或躍在淵,无咎。",
			"startMs": 17460,
			"endMs": 20640
		},
		{
			"speaker": "說書人",
			"text": "九五飛龍在天,利見大人。",
			"startMs": 20640,
			"endMs": 24800
		},
		{
			"speaker": "說書人",
			"text": "上九亢龍有悔。",
			"startMs": 24800,
			"endMs": 27620
		},
		{
			"speaker": "說書人",
			"text": "用九見群龍无首,吉。",
			"startMs": 27620,
			"endMs": 30840
		}
	]
}
