	"segments": [
		{
			"speaker": "說書人",
			"text": "第一卦,乾。",
			"startMs": 0,
			"endMs": 1220
		},
		{
			"speaker": "說書人",
			"text": "乾元、亨、利、貞。",
			"startMs": 1220,
			"endMs": 3720
		},
		{
			"speaker": "說書人",
			"text": "初九潛龍勿用。",
			"startMs": 3720,
			"endMs": 6300
		},
		{
			"speaker": "說書人",
			"text": "九二見龍在田,利見大人。",
			"startMs": 6300,
			"endMs": 10140
		},
		{
			"speaker": "說書人",
			"text": "九三君子終日乾乾,夕惕若厲,无咎。",
			"startMs": 10140,
			"endMs": 14900
		},
		{
			"speaker": "說書人",
			"text": "九四或躍在淵,无咎。",
			"startMs": 14900,
			"endMs": 17880
		},
		{
			"speaker": "說書人",
			"text": "九五飛龍在天,利見大人。",
			"startMs": 17880,
			"endMs": 21720
		},
		{
			"speaker": "說書人",
			"text": "上九亢龍有悔。",
			"startMs": 21720,
			"endMs": 24420
		},
		{
			"speaker": "說書人",
			"text": "用九見群龍无首,吉。",
			"startMs": 24420,
			"endMs": 27600
		}
	]
}
