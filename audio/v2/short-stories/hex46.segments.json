	"segments": [
		{
			"speaker": "說書人",
			"text": "第四十六卦,升。",
			"startMs": 0,
			"endMs": 2060
		},
		{
			"speaker": "讀者",
			"text": "升元亨,用見大人,勿恤,南征吉。",
			"startMs": 2060,
			"endMs": 7260
		},
		{
			"speaker": "讀者",
			"text": "初六允升,大吉。",
			"startMs": 7260,
			"endMs": 10120
		},
		{
			"speaker": "讀者",
			"text": "九二孚乃利用禴,无咎。",
			"startMs": 10120,
			"endMs": 13700
		},
		{
			"speaker": "讀者",
			"text": "九三升虛邑。",
			"startMs": 13700,
			"endMs": 16240
		},
		{
			"speaker": "讀者",
			"text": "六四王用亨于岐山,吉,无咎。",
			"startMs": 16240,
			"endMs": 21200
		},
		{
			"speaker": "讀者",
			"text": "六五貞吉,升階。",
			"startMs": 21200,
			"endMs": 24300
		},
		{
			"speaker": "讀者",
			"text": "上六冥升,利于不息之貞。",
			"startMs": 24300,
			"endMs": 28120
		}
	]
}
