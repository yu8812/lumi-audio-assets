	"segments": [
		{
			"speaker": "說書人",
			"text": "第四十六卦,升。",
			"startMs": 0,
			"endMs": 2180
		},
		{
			"speaker": "說書人",
			"text": "升元亨,用見大人,勿恤,南征吉。",
			"startMs": 2180,
			"endMs": 8060
		},
		{
			"speaker": "說書人",
			"text": "初六允升,大吉。",
			"startMs": 8060,
			"endMs": 11400
		},
		{
			"speaker": "說書人",
			"text": "九二孚乃利用禴,无咎。",
			"startMs": 11400,
			"endMs": 15300
		},
		{
			"speaker": "說書人",
			"text": "九三升虛邑。",
			"startMs": 15300,
			"endMs": 17800
		},
		{
			"speaker": "說書人",
			"text": "六四王用亨于岐山,吉,无咎。",
			"startMs": 17800,
			"endMs": 22040
		},
		{
			"speaker": "說書人",
			"text": "六五貞吉,升階。",
			"startMs": 22040,
			"endMs": 25140
		},
		{
			"speaker": "說書人",
			"text": "上六冥升,利于不息之貞。",
			"startMs": 25140,
			"endMs": 29320
		}
	]
}
