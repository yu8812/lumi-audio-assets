		{
			"speaker": "說書人",
			"text": "第四十六卦,升。",
			"startMs": 0,
			"endMs": 1980
		},
		{
			"speaker": "說書人",
			"text": "升元亨,用見大人,勿恤,南征吉。",
			"startMs": 1980,
			"endMs": 7420
		},
		{
			"speaker": "說書人",
			"text": "初六允升,大吉。",
			"startMs": 7420,
			"endMs": 10320
		},
		{
			"speaker": "說書人",
			"text": "九二孚乃利用禴,无咎。",
			"startMs": 10320,
			"endMs": 13980
		},
		{
			"speaker": "說書人",
			"text": "九三升虛邑。",
			"startMs": 13980,
			"endMs": 16400
		},
		{
			"speaker": "說書人",
			"text": "六四王用亨于岐山,吉,无咎。",
			"startMs": 16400,
			"endMs": 21280
		},
		{
			"speaker": "說書人",
			"text": "六五貞吉,升階。",
			"startMs": 21280,
			"endMs": 23900
		},
		{
			"speaker": "說書人",
			"text": "上六冥升,利于不息之貞。",
			"startMs": 23900,
			"endMs": 28000
		}
	]
}
