	"segments": [
		{
			"speaker": "說書人",
			"text": "第四十六卦,升。",
			"startMs": 0,
			"endMs": 1820
		},
		{
			"speaker": "說書人",
			"text": "升元亨,用見大人,勿恤,南征吉。",
			"startMs": 1820,
			"endMs": 6460
		},
		{
			"speaker": "說書人",
			"text": "初六允升,大吉。",
			"startMs": 6460,
			"endMs": 9200
		},
		{
			"speaker": "說書人",
			"text": "九二孚乃利用禴,无咎。",
			"startMs": 9200,
			"endMs": 12180
		},
		{
			"speaker": "說書人",
			"text": "九三升虛邑。",
			"startMs": 12180,
			"endMs": 14560
		},
		{
			"speaker": "說書人",
			"text": "六四王用亨于岐山,吉,无咎。",
			"startMs": 14560,
			"endMs": 19000
		},
		{
			"speaker": "說書人",
			"text": "六五貞吉,升階。",
			"startMs": 19000,
			"endMs": 21820
		},
		{
			"speaker": "說書人",
			"text": "上六冥升,利于不息之貞。",
			"startMs": 21820,
			"endMs": 25240
		}
	]
}
