	"segments": [
		{
			"speaker": "說書人",
			"text": "第四十六卦,升。",
			"startMs": 0,
			"endMs": 1660
		},
		{
			"speaker": "說書人",
			"text": "升元亨,用見大人,勿恤,南征吉。",
			"startMs": 1660,
			"endMs": 6100
		},
		{
			"speaker": "說書人",
			"text": "初六允升,大吉。",
			"startMs": 6100,
			"endMs": 8640
		},
		{
			"speaker": "說書人",
			"text": "九二孚乃利用禴,无咎。",
			"startMs": 8640,
			"endMs": 11700
		},
		{
			"speaker": "說書人",
			"text": "九三升虛邑。",
			"startMs": 11700,
			"endMs": 14000
		},
		{
			"speaker": "說書人",
			"text": "六四王用亨于岐山,吉,无咎。",
			"startMs": 14000,
			"endMs": 18280
		},
		{
			"speaker": "說書人",
			"text": "六五貞吉,升階。",
			"startMs": 18280,
			"endMs": 21020
		},
		{
			"speaker": "說書人",
			"text": "上六冥升,利于不息之貞。",
			"startMs": 21020,
			"endMs": 24320
		}
	]
}
