	"segments": [
		{
			"speaker": "說書人",
			"text": "第四十卦,解。",
			"startMs": 0,
			"endMs": 2260
		},
		{
			"speaker": "讀者",
			"text": "解利西南。无所往,其來復吉;有攸往,夙吉。",
			"startMs": 2260,
			"endMs": 9080
		},
		{
			"speaker": "讀者",
			"text": "初六无咎。",
			"startMs": 9080,
			"endMs": 11220
		},
		{
			"speaker": "讀者",
			"text": "九二田獲三狐,得黃矢,貞吉。",
			"startMs": 11220,
			"endMs": 15940
		},
		{
			"speaker": "讀者",
			"text": "六三負且乘,致寇至,貞吝。",
			"startMs": 15940,
			"endMs": 20040
		},
		{
			"speaker": "讀者",
			"text": "九四解而拇,朋至斯孚。",
			"startMs": 20040,
			"endMs": 23900
		},
		{
			"speaker": "讀者",
			"text": "六五君子維有解,吉,有孚于小人。",
			"startMs": 23900,
			"endMs": 29220
		},
		{
			"speaker": "讀者",
			"text": "上六公用射隼于高墉之上,獲之,无不利。",
			"startMs": 29220,
			"endMs": 34820
		}
	]
}
