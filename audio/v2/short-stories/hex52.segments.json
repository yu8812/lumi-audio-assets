	"slug": "hex52",
	"title": "第五十二卦 艮",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex52.mp3",
	"durationMs": 27000,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第五十二卦,艮。",
			"startMs": 0,
			"endMs": 1500
		},
		{
			"speaker": "說書人",
			"text": "艮其背,不獲其身;行其庭,不見其人,无咎。",
			"startMs": 1500,
			"endMs": 5340
		},
		{
			"speaker": "說書人",
			"text": "初六艮其趾,无咎,利永貞。",
			"startMs": 5340,
			"endMs": 9120
		},
		{
			"speaker": "說書人",
			"text": "六二艮其腓,不拯其隨,其心不快。",
			"startMs": 9120,
			"endMs": 13760
		},
		{
			"speaker": "說書人",
			"text": "九三艮其限,列其夤,厲薰心。",
			"startMs": 13760,
			"endMs": 18020
		},
		{
			"speaker": "說書人",
			"text": "六四艮其身,无咎。",
			"startMs": 18020,
			"endMs": 20720
		},
		{
			"speaker": "說書人",
			"text": "六五艮其輔,言有序,悔亡。",
			"startMs": 20720,
			"endMs": 24380
		},
		{
			"speaker": "說書人",
			"text": "上九敦艮,吉。",
			"startMs": 24380,
			"endMs": 27000
		}
	]
}
