{
	"slug": "hex52",
	"title": "第五十二卦 艮",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex52.mp3",
	"durationMs": 33600,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第五十二卦,艮。",
			"startMs": 0,
			"endMs": 2100
		},
		{
			"speaker": "說書人",
			"text": "艮其背,不獲其身;行其庭,不見其人,无咎。",
			"startMs": 2100,
			"endMs": 8020
		},
		{
			"speaker": "說書人",
			"text": "初六艮其趾,无咎,利永貞。",
			"startMs": 8020,
			"endMs": 12560
		},
		{
			"speaker": "說書人",
			"text": "六二艮其腓,不拯其隨,其心不快。",
			"startMs": 12560,
			"endMs": 18080
		},
		{
			"speaker": "說書人",
			"text": "九三艮其限,列其夤,厲薰心。",
			"startMs": 18080,
			"endMs": 22860
		},
		{
			"speaker": "說書人",
			"text": "六四艮其身,无咎。",
			"startMs": 22860,
			"endMs": 26200
		},
		{
			"speaker": "說書人",
			"text": "六五艮其輔,言有序,悔亡。",
			"startMs": 26200,
			"endMs": 30980
		},
		{
			"speaker": "說書人",
			"text": "上九敦艮,吉。",
			"startMs": 30980,
			"endMs": 33600
		}
	]
}
