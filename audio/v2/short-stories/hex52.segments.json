	"slug": "hex52",
	"title": "第五十二卦 艮",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex52.mp3",
	"durationMs": 27680,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第五十二卦,艮。",
			"startMs": 0,
			"endMs": 1580
		},
		{
			"speaker": "說書人",
			"text": "艮其背,不獲其身;行其庭,不見其人,无咎。",
			"startMs": 1580,
			"endMs": 5940
		},
		{
			"speaker": "說書人",
			"text": "初六艮其趾,无咎,利永貞。",
			"startMs": 5940,
			"endMs": 9360
		},
		{
			"speaker": "說書人",
			"text": "六二艮其腓,不拯其隨,其心不快。",
			"startMs": 9360,
			"endMs": 14080
		},
		{
			"speaker": "說書人",
			"text": "九三艮其限,列其夤,厲薰心。",
			"startMs": 14080,
			"endMs": 17820
		},
		{
			"speaker": "說書人",
			"text": "六四艮其身,无咎。",
			"startMs": 17820,
			"endMs": 20640
		},
		{
			"speaker": "說書人",
			"text": "六五艮其輔,言有序,悔亡。",
			"startMs": 20640,
			"endMs": 24620
		},
		{
			"speaker": "說書人",
			"text": "上九敦艮,吉。",
			"startMs": 24620,
			"endMs": 27680
		}
	]
}
