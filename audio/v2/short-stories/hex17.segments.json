	"segments": [
		{
			"speaker": "說書人",
			"text": "第十七卦,隨。",
			"startMs": 0,
			"endMs": 1540
		},
		{
			"speaker": "說書人",
			"text": "隨元亨利貞,无咎。",
			"startMs": 1540,
			"endMs": 4680
		},
		{
			"speaker": "說書人",
			"text": "初九官有渝,貞吉。出門交有功。",
			"startMs": 4680,
			"endMs": 9200
		},
		{
			"speaker": "說書人",
			"text": "六二係小子,失丈夫。",
			"startMs": 9200,
			"endMs": 12220
		},
		{
			"speaker": "說書人",
			"text": "六三係丈夫,失小子。隨有求得,利居貞。",
			"startMs": 12220,
			"endMs": 17420
		},
		{
			"speaker": "說書人",
			"text": "九四隨有獲,貞凶。有孚在道,以明,何咎?",
			"startMs": 17420,
			"endMs": 23080
		},
		{
			"speaker": "說書人",
			"text": "九五孚于嘉,吉。",
			"startMs": 23080,
			"endMs": 25500
		},
		{
			"speaker": "說書人",
			"text": "上六拘係之,乃從維之。王用亨于西山。",
			"startMs": 25500,
			"endMs": 30700
		}
	]
}
