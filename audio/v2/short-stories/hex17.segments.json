	"segments": [
		{
			"speaker": "說書人",
			"text": "第十七卦,隨。",
			"startMs": 0,
			"endMs": 1460
		},
		{
			"speaker": "說書人",
			"text": "隨元亨利貞,无咎。",
			"startMs": 1460,
			"endMs": 5280
		},
		{
			"speaker": "說書人",
			"text": "初九官有渝,貞吉。出門交有功。",
			"startMs": 5280,
			"endMs": 9880
		},
		{
			"speaker": "說書人",
			"text": "六二係小子,失丈夫。",
			"startMs": 9880,
			"endMs": 12780
		},
		{
			"speaker": "說書人",
			"text": "六三係丈夫,失小子。隨有求得,利居貞。",
			"startMs": 12780,
			"endMs": 17580
		},
		{
			"speaker": "說書人",
			"text": "九四隨有獲,貞凶。有孚在道,以明,何咎?",
			"startMs": 17580,
			"endMs": 23280
		},
		{
			"speaker": "說書人",
			"text": "九五孚于嘉,吉。",
			"startMs": 23280,
			"endMs": 25820
		},
		{
			"speaker": "說書人",
			"text": "上六拘係之,乃從維之。王用亨于西山。",
			"startMs": 25820,
			"endMs": 30780
		}
	]
}
