	"segments": [
		{
			"speaker": "說書人",
			"text": "第十七卦,隨。",
			"startMs": 0,
			"endMs": 1940
		},
		{
			"speaker": "讀者",
			"text": "隨元亨利貞,无咎。",
			"startMs": 1940,
			"endMs": 5320
		},
		{
			"speaker": "讀者",
			"text": "初九官有渝,貞吉。出門交有功。",
			"startMs": 5320,
			"endMs": 10360
		},
		{
			"speaker": "讀者",
			"text": "六二係小子,失丈夫。",
			"startMs": 10360,
			"endMs": 13580
		},
		{
			"speaker": "讀者",
			"text": "六三係丈夫,失小子。隨有求得,利居貞。",
			"startMs": 13580,
			"endMs": 19900
		},
		{
			"speaker": "讀者",
			"text": "九四隨有獲,貞凶。有孚在道,以明,何咎?",
			"startMs": 19900,
			"endMs": 26280
		},
		{
			"speaker": "讀者",
			"text": "九五孚于嘉,吉。",
			"startMs": 26280,
			"endMs": 29060
		},
		{
			"speaker": "讀者",
			"text": "上六拘係之,乃從維之。王用亨于西山。",
			"startMs": 29060,
			"endMs": 34900
		}
	]
}
