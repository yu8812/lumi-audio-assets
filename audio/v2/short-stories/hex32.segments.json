	"segments": [
		{
			"speaker": "說書人",
			"text": "第三十二卦,恆。",
			"startMs": 0,
			"endMs": 1940
		},
		{
			"speaker": "說書人",
			"text": "恆亨,无咎,利貞,利有攸往。",
			"startMs": 1940,
			"endMs": 6020
		},
		{
			"speaker": "說書人",
			"text": "初六浚恆,貞凶,无攸利。",
			"startMs": 6020,
			"endMs": 9320
		},
		{
			"speaker": "說書人",
			"text": "九二悔亡。",
			"startMs": 9320,
			"endMs": 11420
		},
		{
			"speaker": "說書人",
			"text": "九三不恆其德,或承之羞,貞吝。",
			"startMs": 11420,
			"endMs": 15900
		},
		{
			"speaker": "說書人",
			"text": "九四田无禽。",
			"startMs": 15900,
			"endMs": 18400
		},
		{
			"speaker": "說書人",
			"text": "六五恆其德,貞,婦人吉,夫子凶。",
			"startMs": 18400,
			"endMs": 22960
		},
		{
			"speaker": "說書人",
			"text": "上六振恆,凶。",
			"startMs": 22960,
			"endMs": 25460
		}
	]
}
