	"segments": [
		{
			"speaker": "說書人",
			"text": "第三十二卦,恆。",
			"startMs": 0,
			"endMs": 2140
		},
		{
			"speaker": "說書人",
			"text": "恆亨,无咎,利貞,利有攸往。",
			"startMs": 2140,
			"endMs": 7100
		},
		{
			"speaker": "說書人",
			"text": "初六浚恆,貞凶,无攸利。",
			"startMs": 7100,
			"endMs": 11120
		},
		{
			"speaker": "說書人",
			"text": "九二悔亡。",
			"startMs": 11120,
			"endMs": 13180
		},
		{
			"speaker": "說書人",
			"text": "九三不恆其德,或承之羞,貞吝。",
			"startMs": 13180,
			"endMs": 18140
		},
		{
			"speaker": "說書人",
			"text": "九四田无禽。",
			"startMs": 18140,
			"endMs": 20560
		},
		{
			"speaker": "說書人",
			"text": "六五恆其德,貞,婦人吉,夫子凶。",
			"startMs": 20560,
			"endMs": 26000
		},
		{
			"speaker": "說書人",
			"text": "上六振恆,凶。",
			"startMs": 26000,
			"endMs": 28460
		}
	]
}
