	"title": "第三十二卦 恆",
	"language": "zh-TW",
	"audio": "/audio/v2/short-stories/hex32.mp3",
	"durationMs": 29140,
	"segments": [
		{
			"speaker": "說書人",
			"text": "第三十二卦,恆。",
			"startMs": 0,
			"endMs": 2540
		},
		{
			"speaker": "說書人",
			"text": "恆亨,无咎,利貞,利有攸往。",
			"startMs": 2540,
			"endMs": 7420
		},
		{
			"speaker": "說書人",
			"text": "初六浚恆,貞凶,无攸利。",
			"startMs": 7420,
			"endMs": 11480
		},
		{
			"speaker": "說書人",
			"text": "九二悔亡。",
			"startMs": 11480,
			"endMs": 13620
		},
		{
			"speaker": "說書人",
			"text": "九三不恆其德,或承之羞,貞吝。",
			"startMs": 13620,
			"endMs": 19020
		},
		{
			"speaker": "說書人",
			"text": "九四田无禽。",
			"startMs": 19020,
			"endMs": 21520
		},
		{
			"speaker": "說書人",
			"text": "六五恆其德,貞,婦人吉,夫子凶。",
			"startMs": 21520,
			"endMs": 26600
		},
		{
			"speaker": "說書人",
			"text": "上六振恆,凶。",
			"startMs": 26600,
			"endMs": 29140
		}
	]
}
