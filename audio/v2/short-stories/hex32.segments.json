	"segments": [
		{
			"speaker": "說書人",
			"text": "第三十二卦,恆。",
			"startMs": 0,
			"endMs": 1620
		},
		{
			"speaker": "說書人",
			"text": "恆亨,无咎,利貞,利有攸往。",
			"startMs": 1620,
			"endMs": 5860
		},
		{
			"speaker": "說書人",
			"text": "初六浚恆,貞凶,无攸利。",
			"startMs": 5860,
			"endMs": 9040
		},
		{
			"speaker": "說書人",
			"text": "九二悔亡。",
			"startMs": 9040,
			"endMs": 11140
		},
		{
			"speaker": "說書人",
			"text": "九三不恆其德,或承之羞,貞吝。",
			"startMs": 11140,
			"endMs": 15780
		},
		{
			"speaker": "說書人",
			"text": "九四田无禽。",
			"startMs": 15780,
			"endMs": 18160
		},
		{
			"speaker": "說書人",
			"text": "六五恆其德,貞,婦人吉,夫子凶。",
			"startMs": 18160,
			"endMs": 22600
		},
		{
			"speaker": "說書人",
			"text": "上六振恆,凶。",
			"startMs": 22600,
			"endMs": 25020
		}
	]
}
